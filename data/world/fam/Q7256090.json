reativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1272582","ar":"ببغاء التين برتقالي الصدر","sci":"Cyclopsitta gulielmitertii","en":"Blue-fronted fig parrot","iucn":"LC","wdrev":2533991237,"head":"ببغاء","root":null,"arwiki":{"title":"ببغاء التين برتقالي الصدر","rev":74967427,"text":["ببغاء التين برتقالي الصدر (الاسم العلمي: Cyclopsitta gulielmitertii) (الإنجليزية: Orange-breasted fig parrot) ، هو نوع ينتمي إلى بستاكوليداي (فصيلة: Psittaculidae) ."]},"enwiki":"Blue-fronted fig parrot","image":{"file":"Cyclopsitta gulielmitertii qtl2.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/e/ea/Cyclopsitta_gulielmitertii_qtl2.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Cyclopsitta_gulielmitertii_qtl2.jpg/960px-Cyclopsitta_gulielmitertii_qtl2.jpg","page":"https://commons.wikimedia.org/wiki/File:Cyclopsitta_gulielmitertii_qtl2.jpg","author":"Quartl","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q27075029","ar":"ببغاء الفردوس","sci":"Psephotellus pulcherrimus","en":"Paradise Parrot","iucn":"EX","wdrev":2541666915,"head":"ببغاء","root":null,"arwiki":{"title":"ببغاء الفردوس","rev":74647933,"text":["ببغاء الفردوس (الاسم العلمي: Psephotellus pulcherrimus) هو وهو ببغاء ملون متوسط الحجم المنقرض من ببغاوات المروج كان يعيش في في كوينزلاند وويلز الجنوبية الجديدة في أستراليا. كان هذا النوع شائعاً إلى حد ما ضمن نطاقه المحدود نوعاً ما، ثم انقرض في عام 1927."]},"enwiki":"Paradise parrot","image":{"file":"Landesmuseum Natur und Mensch 035.JPG","src":"https://upload.wikimedia.org/wikipedia/commons/7/75/Landesmuseum_Natur_und_Mensch_035.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/Landesmuseum_Natur_und_Mensch_035.JPG/960px-Landesmuseum_Natur_und_Mensch_035.JPG","page":"https://commons.wikimedia.org/wiki/File:Landesmuseum_Natur_und_Mensch_035.JPG","author":"Einsamer Schütze","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q27075027","ar":"ببغاء ذهبي الكتفين","sci":"Psephotellus chrysopterygius","en":"Golden-shouldered Parrot","iucn":null,"wdrev":2541666871,"head":"ببغاء","root":null,"arwiki":{"title":"ببغاء ذو كتف ذهبي","rev":76352250,"text":["ببغاء ذو الكتف الذهبي (الاسم العلمي: Psephotellus chrysopterygius) هو طائر نادر يعيش في جنوب شبه جزيرة كيب يورك، في كوينزلاند، أستراليا. وهو ببغاء صغير من ببغاوات المروج يرتبط بالببغاء المقنع الأكثر شيوعًا في الإقليم الشمالي وببغاء الفردوس المنقرض في كوينزلاند وويلز الجنوبية الجديدة."]},"enwiki":"Golden-shouldered parrot","image":{"file":"Golden-shouldered Parrot 0A2A7450.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/8/85/Golden-shouldered_Parrot_0A2A7450.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Golden-shouldered_Parrot_0A2A7450.jpg/960px-Golden-shouldered_Parrot_0A2A7450.jpg","page":"https://commons.wikimedia.org/wiki/File:Golden-shouldered_Parrot_0A2A7450.jpg","author":"JJ Harrison","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q612426","ar":"ببغاء رمادي الرأس","sci":"Psittacula finschii","en":"Grey-headed Parakeet","iucn":"NT","wdrev":2538986823,"head":"ببغاء","root":null,"arwiki":{"title":"درة رمادية الرأس","rev":76487680,"text":["درة رمادية الرأس (الاسم العلمي: Psittacula finschii) هو نوع من جنس بستاكولا."]},"enwiki":"Grey-headed parakeet","image":{"file":"PalaeornisFinschiKeulemans.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/a/a2/PalaeornisFinschiKeulemans.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/a/a2/PalaeornisFinschiKeulemans.jpg","page":"https://commons.wikimedia.org/wiki/File:PalaeornisFinschiKeulemans.jpg","author":"John Gerrard Keulemans","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q337797","ar":"ببغاء سريلانكا المعلق","sci":"Loriculus beryllinus","en":"Sri Lanka Hanging Parrot","iucn":"LC","wdrev":2557683593,"head":"ببغاء","root":null,"arwiki":{"title":"ببغاء سريلانكا المعلق","rev":69848453,"text":["ببغاء سريلانكا المعلق ببغاء صغير الحجم متوطن ومقيم في سريلانكا.","يسمى هذا الطائر في سريلانكا جيرا ماليتا (بالسنهالية: ගිරාමලිත්තා) أو بول جيروا (بالسنهالية: පොල් ගිරවා). ظهرت صورة الطائر على طابع بريدي سريلانكي قيمنه 15 سنت. كما ظهرت صورته على ورقة نقدية قيمتها 1000 روبية سريلانكية الصادرة منذ عام 2010 وكذلك الورقة النقدية التذكارية التي أصدرت في 4 فبراير 2018 لمناسبة الذكرى السبعون لاستقلال سريلانكا (1948-2018)."]},"enwiki":"Sri Lanka hanging parrot","image":{"file":"Loriculus beryllinus -Sri Lanka -adult-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/8/81/Loriculus_beryllinus_-Sri_Lanka_-adult-8.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/Loriculus_beryllinus_-Sri_Lanka_-adult-8.jpg/960px-Loriculus_beryllinus_-Sri_Lanka_-adult-8.jpg","page":"https://commons.wikimedia.org/wiki/File:Loriculus_beryllinus_-Sri_Lanka_-adult-8.jpg","author":"Hafiz Issadeen","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q27075024","ar":"ببغاء مقنع","sci":"Psephotellus dissimilis","en":"Hooded Parrot","iucn":"LC","wdrev":2533994475,"head":"ببغاء","root":null,"arwiki":{"title":"ببغاء مقنع","rev":75019107,"text":["ببغاء مقنع (اللاتينية: Psephotus dissimilis) (الإنجليزية: Hooded parrot) ، هو نوع ينتمي إلى بستاكوليداي (فصيلة: Psittaculidae) ."]},"enwiki":"Hooded parrot","image":{"file":"Psephotus dissimilis -Australia -pair-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/64/Psephotus_dissimilis_-Australia_-pair-8.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Psephotus_dissimilis_-Australia_-pair-8.jpg/960px-Psephotus_dissimilis_-Australia_-pair-8.jpg","page":"https://commons.wikimedia.org/wiki/File:Psephotus_dissimilis_-Australia_-pair-8.jpg","author":"birdphotosneill","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q27075022","ar":"ببغاء مولجا","sci":"Psephotellus varius","en":"Psephotellus varius","iucn":"LC","wdrev":2533994473,"head":"ببغاء","root":null,"arwiki":{"title":"ببغاء مولجا","rev":74967458,"text":["ببغاء مولجا (اللاتينية: Psephotus varius) (الإنجليزية: Mulga parrot) ، هو نوع ينتمي إلى بستاكوليداي (فصيلة: Psittaculidae) ."]},"enwiki":"Mulga parrot","image":{"file":"Mulga Parrot male 2 - Patchewollock.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/c/c9/Mulga_Parrot_male_2_-_Patchewollock.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Mulga_Parrot_male_2_-_Patchewollock.jpg/960px-Mulga_Parrot_male_2_-_Patchewollock.jpg","page":"https://commons.wikimedia.org/wiki/File:Mulga_Parrot_male_2_-_Patchewollock.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q913813","ar":"درة برقوقية الرأس","sci":"Psittacula cyanocephala","en":"Plum-headed Parakeet","iucn":"LC","wdrev":2556931285,"head":"درة","root":null,"arwiki":{"title":"درة برقوقية الرأس","rev":76487670,"text":["درة برقوقية الرأس (الاسم العلمي: Psittacula cyanocephala) (الإنجليزية: Plum-headed Parakeet)، هو طائر ينتمي إلى فصيلة ببغاوات العالم القديم (الاسم العلمي: Psittaculidae)."]},"enwiki":"Plum-headed parakeet","image":{"file":"A Female Plum Headed Parakeet (50263113627).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/8/8d/A_Female_Plum_Headed_Parakeet_%2850263113627%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/A_Female_Plum_Headed_Parakeet_%2850263113627%29.jpg/960px-A_Female_Plum_Headed_Parakeet_%2850263113627%29.jpg","page":"https://commons.wikimedia.org/wiki/File:A_Female_Plum_Headed_Parakeet_(50263113627).jpg","author":"Hari K Patibanda","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1271952","ar":"درة زهرية الرأس","sci":"Psittacula roseata","en":"Blossom-headed Parakeet","iucn":"NT","wdrev":2558489782,"head":"درة","root":null,"arwiki":{"title":"درة زهرية الرأس","rev":76487681,"text":["الدُّرَّة زهرية الرأس (الاسم العلمي: Psittacula roseata) هو نوع من الببغاوات يتبع جنس الدرة ضمن الفصيلة الدرية (ببغاوات العالم القديم)."]},"enwiki":"Blossom-headed parakeet","image":{"file":"Blossom-headed Parakeet, Satchari NP, Bangladesh.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/8/8e/Blossom-headed_Parakeet%2C_Satchari_NP%2C_Bangladesh.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Blossom-headed_Parakeet%2C_Satchari_NP%2C_Bangladesh.jpg/960px-Blossom-headed_Parakeet%2C_Satchari_NP%2C_Bangladesh.jpg","page":"https://commons.wikimedia.org/wiki/File:Blossom-headed_Parakeet,_Satchari_NP,_Bangladesh.jpg","author":"Nafis Ameen","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q692953","ar":"درة لايارد","sci":"Psittacula calthrapae","en":"Layard's Parakeet","iucn":"LC","wdrev":2538995871,"head":"درة","root":null,"arwiki":{"title":"درة لايارد","rev":76487688,"text":["درة لايارد أو ببغاء لايارد هو ببغاء أو درة متوطنة في سريلانكا. سمي هذا الطائر بهذاا الاسم احتفاء بالعالم البريطاني إدغار ليوبولد لايارد؛ كما أن زوجته الأولى، باربرا آن كالثروب، التي تزوجها في عام 1845، تُخلد ذكراها بهذا اللقب الخاص."]},"enwiki":"Layard's parakeet","image":{"file":"Psittacula calthropae -Sri Lanka -eating fruit-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/fa/Psittacula_calthropae_-Sri_Lanka_-eating_fruit-8.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Psittacula_calthropae_-Sri_Lanka_-eating_fruit-8.jpg/960px-Psittacula_calthropae_-Sri_Lanka_-eating_fruit-8.jpg","page":"https://commons.wikimedia.org/wiki/File:Psittacula_calthropae_-Sri_Lanka_-eating_fruit-8.jpg","author":"Hafiz Issadeen","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q634873","ar":"درة نيوتن","sci":"Psittacula exsul","en":"Newton's parakeet","iucn":"EX","wdrev":2556166562,"head":"درة","root":null,"arwiki":{"title":"درة نيوتن","rev":76500278,"text":["دُرَّة نيوتن (الاسم العلمي: Psittacula exsul)، المعروفة أيضًا باسم درة رودريغيس أو درة رودريغيس مطوقة العنق، هو نوع منقرض من الببغاوات استوطن جزيرة رودريغيس ضمن جزر ماسكارين في غرب المحيط الهندي. تباعدت العديد من سماته عن الأنواع ذات الصلة، مما يشير إلى العزلة طويلة الأمد في جزيرة رودريغيس والتكيف اللاحق. درة وردية الطوق من نفس الجنس هو سلف قريب ومحتمل. ربما كان ببغاء نيوتن نفسه من أسلاف الببغاوات المستوطنة في موريشيوس وريونيون المجاورتين."]},"enwiki":"Newton's parakeet","image":{"file":"Newton's Parakeet.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/f8/Newton%27s_Parakeet.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/f/f8/Newton%27s_Parakeet.jpg","page":"https://commons.wikimedia.org/wiki/File:Newton%27s_Parakeet.jpg","author":"Jossigny","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q208060","ar":"درة وردية الطوق","sci":"Psittacula krameri","en":"Rose-ringed Parakeet","iucn":"LC","wdrev":2558019210,"head":"درة","root":null,"arwiki":{"title":"درة وردية الطوق","rev":76487694,"text":["الدرة الوردية الطوق أو الدُّرَّة المُطَوَّقَة أو البَرَكيت الأخضر او الدرة الهندية المطوقة هو طائر ينتمي إلى ببغاوات العالم القديم. تطول نحو 16 بوصة وشكلها يساعد على التخفي. ذيولها طويلة أما أحجامها فمتوسطة أو صغيرة. يغلب فيها اللون الأخضر، ومنها الصفراء والزرقاء الرمداء. تبدو الذكور والإناث متشابهةً متناظرةً إلا أن للذكر حلقة سوداء حول عنقه تغيب عند الأُنثى. لكل من الجنسين ذيل طويل مؤلف من 12 ريشة، ويغلب أن يكون لون أكبرها أزرق.توجد في عدت دول منها الوطن العربي وغيرها وتتميز بالذكاء الحاد حيث يمكنها أن تحفظ بعض الكلمات التي تسمعها من الأنسان حين يكررها"]},"enwiki":"Rose-ringed parakeet","image":{"file":"Rose ringed parakeet ( Psittacula krameri) മോതിര തത്ത , നാട്ടു തത്ത 4.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/a/ae/Rose_ringed_parakeet_%28_Psittacula_krameri%29_%E0%B4%AE%E0%B5%8B%E0%B4%A4%E0%B4%BF%E0%B4%B0_%E0%B4%A4%E0%B4%A4%E0%B5%8D%E0%B4%A4_%2C_%E0%B4%A8%E0%B4%BE%E0%B4%9F%E0%B5%8D%E0%B4%9F%E0%B5%81_%E0%B4%A4%E0%B4%A4%E0%B5%8D%E0%B4%A4_4.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ae/Rose_ringed_parakeet_%28_Psittacula_krameri%29_%E0%B4%AE%E0%B5%8B%E0%B4%A4%E0%B4%BF%E0%B4%B0_%E0%B4%A4%E0%B4%A4%E0%B5%8D%E0%B4%A4_%2C_%E0%B4%A8%E0%B4%BE%E0%B4%9F%E0%B5%8D%E0%B4%9F%E0%B5%81_%E0%B4%A4%E0%B4%A4%E0%B5%8D%E0%B4%A4_4.jpg/960px-Rose_ringed_parakeet_%28_Psittacula_krameri%29_%E0%B4%AE%E0%B5%8B%E0%B4%A4%E0%B4%BF%E0%B4%B0_%E0%B4%A4%E0%B4%A4%E0%B5%8D%E0%B4%A4_%2C_%E0%B4%A8%E0%B4%BE%E0%B4%9F%E0%B5%8D%E0%B4%9F%E0%B5%81_%E0%B4%A4%E0%B4%A4%E0%B5%8D%E0%B4%A4_4.jpg","page":"https://commons.wikimedia.org/wiki/File:Rose_ringed_parakeet_(_Psittacula_krameri)_%E0%B4%AE%E0%B5%8B%E0%B4%A4%E0%B4%BF%E0%B4%B0_%E0%B4%A4%E0%B4%A4%E0%B5%8D%E0%B4%A4_,_%E0%B4%A8%E0%B4%BE%E0%B4%9F%E0%B5%8D%E0%B4%9F%E0%B5%81_%E0%B4%A4%E0%B4%A4%E0%B5%8D%E0%B4%A4_4.jpg","author":"Afsarnayakkan","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","origin":null},"audio":{"file":"Psittacula krameri - Rose-ringed Parakeet XC35091.mp3","src":"https://upload.wikimedia.org/wikipedia/commons/c/ce/Psittacula_krameri_-_Rose-ringed_Parakeet_XC35091.mp3","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wik