{"id":"Q217484","sci":"Anhimidae","ar":"صياح","ord":{"id":"Q21651","sci":"Anseriformes","ar":"إوزيات"},"birds":[{"id":"Q732753","ar":"ذو القرنين الصّياح","sci":"Anhima cornuta","en":"Horned Screamer","iucn":"LC","wdrev":2538993967,"head":"ذو","root":null,"arwiki":{"title":"صياح مقرن","rev":76375058,"text":["الصياح المقرن (الاسم العلمي: Anhima cornuta)، هو عضو في عائلة صغيرة من الطيور، Anhimidae، والتي تحدث في الأراضي الرطبة في أمريكا الجنوبية الإستوائية. هناك ثلاثة أنواع من الصيّاح، النوعان الآخران هما الصيّاح الجنوبي والصيّاح الشمالي في جنس تشونا. هم من فصيلة البط، الأوز والبجع، وهي من عائلة بطية، لكن لها خواص تشبه تلك الخاصة بالدجاجيات."]},"enwiki":"Horned screamer","image":{"file":"Anhima cornuta (Vincent Vos).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/9/96/Anhima_cornuta_%28Vincent_Vos%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Anhima_cornuta_%28Vincent_Vos%29.jpg/960px-Anhima_cornuta_%28Vincent_Vos%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Anhima_cornuta_(Vincent_Vos).jpg","author":"Vincent Vos Bolivia","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":{"file":"Inhuma.ogg","src":"https://upload.wikimedia.org/wikipedia/commons/2/25/Inhuma.ogg","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wiki/File:Inhuma.ogg","author":"Djino","license":"Public domain","licenseUrl":null,"origin":null},"audioFromSearch":false,"video":null},{"id":"Q997306","ar":null,"sci":"Chauna chavaria","en":"Northern Screamer","iucn":"LC","wdrev":2539003468,"head":null,"root":null,"arwiki":null,"enwiki":"Northern screamer","image":{"file":"Chauna chavaria-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/a/af/Chauna_chavaria-8.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/af/Chauna_chavaria-8.jpg/960px-Chauna_chavaria-8.jpg","page":"https://commons.wikimedia.o