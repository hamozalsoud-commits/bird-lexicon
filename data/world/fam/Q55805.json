null,"wdrev":2550417005,"head":"قطرس","root":null,"arwiki":{"title":"قطرس أصفر الأنف أطلنطي","rev":72190805,"text":["قطرس أصفر الأنف أطلنطي (الاسم العلمي: Thalassarche chlororhynchos) هو نوع من فصيلة قطرس."]},"enwiki":"Atlantic yellow-nosed albatross","image":{"file":"Albatros à bec jaunes.JPG","src":"https://upload.wikimedia.org/wikipedia/commons/e/ec/Albatros_%C3%A0_bec_jaunes.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Albatros_%C3%A0_bec_jaunes.JPG/960px-Albatros_%C3%A0_bec_jaunes.JPG","page":"https://commons.wikimedia.org/wiki/File:Albatros_%C3%A0_bec_jaunes.JPG","author":"Vincent Legendre","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q208682","ar":"قطرس جوال","sci":"Diomedea exulans","en":"Wandering Albatross","iucn":"VU","wdrev":2549473772,"head":"قطرس","root":null,"arwiki":{"title":"قطرس جوال","rev":62701140,"text":["القطرس الجوال طائر له جناحان يمتدان أكثر من ثلاثة أمتار وربع، وهو أضخم جناح عرف لطائر حي، حيث ينزلق بشكل رائع ويرافق السفن المبحرة دون تعب في البحور الشمالية بين خطي عرض 60ْ , 30ْ شمالاً، يغلب على الطائر البالغ اللون الأسود باستثناء أطراف جناحية الأبيضين، أما الطيور الفتية فهي بنية اللون حتى تبلغ حوالي 135 سم.","منظر الغزل جدير بالملاحظة، حيث يقف كل من الذكر والأنثى متقابلين، والأجنحة منتشرة، العنقان ممدودان والرأسان يتأرجحان من جانب إلى جانب، ويتلامسان بالعنقين والصدرين والمنقارين ويرفع كل منهما ذيله القصير على ظهره.وتتكاثر مرة كل سنتان.","تضع الأنثى بيضة واحدة تزن حوالي نصف كيلوغرام وتمتد فترة الحضانة إلى أكثر من 81 يومًا."]},"enwiki":"Snowy albatross","image":{"file":"Diomedea exulans - SE Tasmania.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/a/aa/Diomedea_exulans_-_SE_Tasmania.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/Diomedea_exulans_-_SE_Tasmania.jpg/960px-Diomedea_exulans_-_SE_Tasmania.jpg","page":"https://commons.wikimedia.org/wiki/File:Diomedea_exulans_-_SE_Tasmania.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1262700","ar":"قطرس خجول","sci":"Thalassarche cauta","en":"Shy Albatross","iucn":"NT","wdrev":2533969321,"head":"قطرس","root":null,"arwiki":{"title":"قطرس خجول","rev":75306972,"text":["باتروس خجول يسمى أيضا قطرس خجول (الاسم العلمي: Diomedea  cauta) أو (الاسم العلمي: Thalassarche cauta) (الإنجليزية: Shy  Albatross) هو طائر ينتمي إلى قطرس (فصيلة: Diomedeidae)."]},"enwiki":"Shy albatross","image":{"file":"Thalassarche cauta - SE Tasmania.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/2/2f/Thalassarche_cauta_-_SE_Tasmania.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Thalassarche_cauta_-_SE_Tasmania.jpg/960px-Thalassarche_cauta_-_SE_Tasmania.jpg","page":"https://commons.wikimedia.org/wiki/File:Thalassarche_cauta_-_SE_Tasmania.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1265896","ar":"قطرس داكن","sci":"Phoebetria fusca","en":"Sooty Albatross","iucn":null,"wdrev":2553907505,"head":"قطرس","root":null,"arwiki":{"title":"قطرس داكن","rev":68446048,"text":["قطرس داكن (الاسم العلمي: Phoebetria fusca) هو نوع من فصيلة قطرس."]},"enwiki":"Sooty albatross","image":{"file":"Phoebetria fusca -Naturhistorisches Museum Wien -4Feb2008.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/8/84/Phoebetria_fusca_-Naturhistorisches_Museum_Wien_-4Feb2008.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Phoebetria_fusca_-Naturhistorisches_Museum_Wien_-4Feb2008.jpg/960px-Phoebetria_fusca_-Naturhistorisches_Museum_Wien_-4Feb2008.jpg","page":"https://commons.wikimedia.org/wiki/File:Phoebetria_fusca_-Naturhistorisches_Museum_Wien_-4Feb2008.jpg","author":"frank wouters from antwerpen, belgium , België , Belgique","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q844776","ar":"قطرس ذو ظهر مضيء","sci":"Phoebetria palpebrata","en":"Light-mantled Albatross","iucn":"NT","wdrev":2550423181,"head":"قطرس","root":null,"arwiki":{"title":"قطرس ذو ظهر مضيء","rev":70935958,"text":["القطرس ذو الظهر المضيء (الاسم العلمي: Phoebetria palpebrata)، ويعرف أيضًا باسم قطرس ذو الظهر الرمادي أو القطرس السخامي ذو الظهر المضيء، هو نوع من جنس القطرس السخامي المنتمي إلى فصيلة القطرسيات. وصف من قبل يوهان راينهولد فورستر، في عام 1785، بناءً على عينة من جنوب رأس الرجاء الصالح."]},"enwiki":"Light-mantled albatross","image":{"file":"Phoebetria palpebrata - Flying 2.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/e/ea/Phoebetria_palpebrata_-_Flying_2.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Phoebetria_palpebrata_-_Flying_2.jpg/960px-Phoebetria_palpebrata_-_Flying_2.jpg","page":"https://commons.wikimedia.org/wiki/File:Phoebetria_palpebrata_-_Flying_2.jpg","author":"François Guerraz","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q786350","ar":"قطرس رأس رمادي","sci":"Thalassarche chrysostoma","en":"Grey-headed Albatross","iucn":null,"wdrev":2550421058,"head":"قطرس","root":null,"arwiki":{"title":"قطرس رأس رمادي","rev":77001685,"text":["قطرس رأس رمادي (الاسم العلمي: Thalassarche chrysostoma) هو نوع من فصيلة قطرس."]},"enwiki":"Grey-headed albatross","image":{"file":"Thalassarche chrysostoma - SE Tasmania.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/1/10/Thalassarche_chrysostoma_-_SE_Tasmania.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Thalassarche_chrysostoma_-_SE_Tasmania.jpg/960px-Thalassarche_chrysostoma_-_SE_Tasmania.jpg","page":"ht