{"id":"Q843381","sci":"Chloropseidae","ar":"طيور الورق","ord":{"id":"Q25341","sci":"Passeriformes","ar":"جواثم"},"birds":[{"id":"Q31874662","ar":"طائر الورقة ذي الأجنحة الزرقاء","sci":"Chloropsis moluccensis","en":"Chloropsis moluccensis","iucn":"LC","wdrev":2533992669,"head":"طاير","root":null,"arwiki":{"title":"طائر الورقة ذي الأجنحة الزرقاء","rev":73484815,"text":["طائر الورق ذو الجناح الأزرق (Chloropsis moluccensis) هو نوع من طيور الورق يوجد في الغابات والمناطق ذات الغطاء النباتي الثانوي في جميع أنحاء جنوب شرق آسيا، من بورنيو شرقًا إلى جنوب سومطرة جنوبًا. كان يُصنف سابقًا ضمن الأنواع الفرعية طائر ورق جيردون (C. jerdoni) من شبه القارة الهندية، وطائر ورق بورنيو (C. kinabaluensis) من شمال بورنيو، ولكنه يختلف عنهما في القياسات والشكل، إذ يفتقر طائر جيردون إلى اللون الأزرق في ريش الطيران، بينما يتميز طائر بورنيو بريش أنثوي يشبه ريش الذكور. كما كان طائر ورق جاوة (C. cochinchinensis)، المتوطن في جاوة، يُصنف سابقًا ضمن هذا النوع، ولكن الدراسات الوراثية الحديثة فصلت بينهما. من المعروف أن نطاق انتشار طائر الورق ذي الجناح الأزرق وطائر ورق بورنيو يتقارب، ولكن لا يوجد دليل على حدوث تداخل بينهما.","الذكر ذو جسم أخضر ورأس مائل إلى الصفرة، ووجه وحلق أسودان. وله خط أزرق على شاربه. أما الأنثى فتختلف عنها في أن رأسها أكثر خضرة وحلقها أزرق، والطيور الصغيرة تشبه الأنثى ولكن بدون رقعة الحلق الزرقاء.","وهو شائع إلى حد ما في معظم نطاق انتشاره، وبالتالي يعتبر من الأنواع الأقل تهديداً من قبل منظمة بيردلايف الدولية.","يفتقر طائر الورق ذو الجبهة الذهبية، المشابه ظاهرياً، إلى اللون الأزرق في ريش الطيران والذيل، وله جبهة ذهبية."]},"enwiki":"Blue-winged leafbird","image":null,"audio":null,"audioFromSearch":false,"video":null},{"id":"Q199963","ar":null,"sci":"Chloropsis aurifrons","en":"Golden-fronted Leafbird","iucn":"LC","wdrev":2538975280,"head":null,"root":null,"arwiki":null,"enwiki":"Golden-fronted leafbird","image":{"file":"Golden Fronted Leafbird Mukulhinge.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/1/1b/Golden_Fronted_Leafbird_Mukulhinge.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/1/1b/Golden_Fronted_Leafbird_Mukulhinge.jpg","page":"https://commons.wikimedia.org/wiki/File:Golden_Fronted_Leafbird_Mukulhinge.jpg","author":"Mukul Hinge","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q430467","ar":null,"sci":"Chloropsis cochinchinensis","en":"Javan leafbird","iucn":null,"wdrev":2543442727,"head":null,"root":null,"arwiki":null,"enwiki":"Javan leafbird","image":{"file":"Chloropsis cochinchinensis -Singapore-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/c/ce/Chloropsis_cochinchinensis_-Singapore-8.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Chloropsis_cochinchinensis_-Singapore-8.jpg/960px-Chloropsis_cochinchinensis_-Singapore-8.jpg","page":"https://commons.wikimedia.org/wiki/File:Chloropsis_cochinchinensis_-Singapore-8.jpg","author":"Lip Kee Yap","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q27632914","ar":null,"sci":"Chloropsis cochinchinensis cochinchinensis","en":"Chloropsis cochinchinensis cochinchinensis","iucn":null,"wdrev":2533992644,"head":null,"root":null,"arwiki":null,"enwiki":null,"image":{"file":"Hijau Daun.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/4/4f/Hijau_Daun.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4f/Hijau_Daun.jpg/960px-Hijau_Daun.jpg","page":"https://commons.wikimedia.org/wiki/File:Hijau_Daun.jpg","author":"Panji Gusti Akbar","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1123850","ar":null,"sci":"Chloropsis cyanopogon","en":"Lesser Green Leafbird","iucn":"NT","wdrev":2533992483,"head":null,"root":null,"arwiki":null,"enwiki":"Lesser green leafbird","image":{"file":"PhyllornisCyanopogon