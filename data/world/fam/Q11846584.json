{"id":"Q11846584","sci":"Pardalotidae","ar":null,"ord":{"id":"Q25341","sci":"Passeriformes","ar":"جواثم"},"birds":[{"id":"Q1301085","ar":"الوجه الأبيض الجنوبي","sci":"Aphelocephala leucopsis","en":"Southern Whiteface","iucn":"VU","wdrev":2541625653,"head":"وجه","root":null,"arwiki":{"title":"الوجه الأبيض الجنوبي","rev":74951998,"text":["الوجه الأبيض الجنوبي (الإنجليزية: Southern whiteface) يعتبر طائر الذي يتوطن أستراليا مستوطنا، وهو عبارة عن جواثم صغيرة توجد في المناطق القاحلة في معظم النصف الجنوبي من القارة، باستثناء تسمانيا. من الناحية السطحية ، يبدو هذا الطائر الحاشر شائعًا نسبيًا في معظم نطاقه."]},"enwiki":"Southern whiteface","image":{"file":"Aphelocephala leucopsis -Waikerie, South Australia, Australia-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/d/d6/Aphelocephala_leucopsis_-Waikerie%2C_South_Australia%2C_Australia-8.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/d/d6/Aphelocephala_leucopsis_-Waikerie%2C_South_Australia%2C_Australia-8.jpg","page":"https://commons.wikimedia.org/wiki/File:Aphelocephala_leucopsis_-Waikerie,_South_Australia,_Australia-8.jpg","author":"Ron Knight","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q939963","ar":"باردالوت مرقط بأربعين نقطة","sci":"Pardalotus quadragintus","en":"Forty-spotted Pardalote","iucn":null,"wdrev":2541660734,"head":"باردالوت","root":null,"arwiki":{"title":"باردالوت مرقط بأربعين نقطة","rev":76560642,"text":["يُعد طائر باردالوت مرقط بأربعين نقطة أي باللاتينية: Pardalotus quadragintus أحد أندر الطيور في أستراليا، وهو أندر أنواع الباردالوت على الإطلاق، حيث يقتصر وجوده على عدد قليل من المستعمرات في الركن الجنوبي الشرقي من تسمانيا، وخاصة في جزيرة ماريا وجزيرة بروني."]},"enwiki":"Forty-spotted pardalote","image":{"file":"Forty-spotted pardalote (Pardalotus quadragintus) South Bruny 3.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/0/03/Forty-spotted_pardalote_%28Pardalotus_quadragintus%29_South_Bruny_3.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Forty-spotted_pardalote_%28Pardalotus_quadragintus%29_South_Bruny_3.jpg/960px-Forty-spotted_pardalote_%28Pardalotus_quadragintus%29_South_Bruny_3.jpg","page":"https://commons.wikimedia.org/wiki/File:Forty-spotted_pardalote_(Pardalotus_quadragintus)_South_Bruny_3.jpg","author":"Charles J. Sharp","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q573169","ar":"روقش","sci":"Pardalotus punctatus","en":"Spotted Pardalote","iucn":"LC","wdrev":2538985890,"head":"روقش","root":null,"arwiki":{"title":"روقش","rev":73251208,"text":["رَوْقَش أو عُصفور ماسِيّ أحد أصغر الطيور الأسترالية حيث يعلو من ٨ إلى ١٠ سم، وأحد أكثر الطيور تلوينًا. ومع أنه شائع في جميع الأجزاء الخصبة في أستراليا (الساحل الشرقي والجنوب الشرقي والزاوية الجنوبية الغربية) إلا أنه نادرًا ما يُرى من كثب لتحديد الهوية."]},"enwiki":"Spotted pardalote","image":{"file":"Pardalotus punctatus male with nesting material - Risdon Brook.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/a/a8/Pardalotus_punctatus_male_with_nesting_material_-_Risdon_Brook.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Pardalotus_punctatus_male_with_nesting_material_-_Risdon_Brook.jpg/960px-Pardalotus_punctatus_male_with_nesting_material_-_Risdon_Brook.jpg","page":"https://commons.wikimedia.org/wiki/File:Pardalotus_punctatus_male_with_nesting_material_-_Risdon_Brook.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":{"file":"Pardalotus punctatus - Spotted Pardalote XC446209.mp3","src":"https://upload.wikimedia.org/wikipedia/commons/e/ee/Pardalotus_punctatus_-_Spotted_Pardalote_XC446209.mp3","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wiki/File:Pardalotus_punctatus_-_Spotted_Pardalote_XC446209.mp3","author":"James Ray","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":"https://xeno-canto.org/446209"},"audioFromSearch":false,"video":{"file":"Spotted Pardalote armstrongck.ogv","src":"https://upload.wikimedia.org/wikipedia/commons/0/0b/Spotted_Pardalote_armstrongck.ogv","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0b/Spotted_Pardalote_armstrongck.ogv/330px--Spotted_Pardalote_armstrongck.ogv.jpg","page":"https://commons.wikimedia.org/wiki/File:Spotted_Pardalote_armstrongck.ogv","author":"Aviceda","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null}},{"id":"Q313390","ar":"هازجة نيوزيلندا الرمادية","sci":"Gerygone igata","en":"Gerygone igata","iucn":"LC","wdrev":2538982654,"head":"هازجة","root":"ه ز ج","arwiki":{"title":"هازجة نيوزيلندا الرمادية","rev":61861511,"text":["الهازجة الرمادية (الاسم العلمي:  Gerygone igata)، المعروفة أيضا باسمها الماوري riroriro (بالعربية: ريروريرو) ومعروفة أحيانا خارج نيوزيلندا باسم جيرجوني الرمادي هذا النوع من الطيور هو آكل حشرات وينتمي لأسرة الطيور المسماة Acanthizidae؛ وتعتبر أنواع الطيور هذه متوطنة في نيوزيلندا. الموائل الطبيعية لهذا الطير هي الغابات المعتدلة. معروف هذا الطير في بعض الأحيان باسم تيتوتام أو راينبيرد، أي طائر المطر."]},"enwiki":"Grey warbler","image":{"file":"Gerygone igata - Saryu Mae 前 朝琉 - 449543477 (cropped).jpeg","src":"https://upload.wikimedia.org/wikipedia/commons/d/db/Gerygone_igata_-_Saryu_Mae_%E5%89%8D_%E6%9C%9D%E7%90%89_-_449543477_%28cropped%29.jpeg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/db/Gerygone_igata_-_Saryu_Mae_%E5%89%8D_%E6%9C%9D%E7%90%89_-_449543477_%28cropped%29.jpeg/960px-Gerygone_igata_-_Saryu_Mae_%E5%89%8D_%E6%9C%9D%E7%90%89_-_449543477_%28cropped%29.jpeg","page":"https://commons.wikimedia.org/wiki/File:Gerygone_igata_-_Saryu_Mae_%E5%89%8D_%E6%9C%9D%E7%90%89_-_449