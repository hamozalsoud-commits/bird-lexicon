{"id":"Q179333","sci":"Paradisaeidae","ar":"طائر الجنة","ord":{"id":"Q25341","sci":"Passeriformes","ar":"جواثم"},"birds":[{"id":"Q1082344","ar":"رفول الملكة كارولا","sci":"Parotia carolae","en":"Parotia carolae","iucn":"LC","wdrev":2534006080,"head":"رفول","root":null,"arwiki":{"title":"رفول الملكة كارولا","rev":68666686,"text":["رفول الملكة كارولا (الاسم العلمي: Parotia carolae)، نوع من الطيور التي تنتمي إلى فصيلة طائر الجنة. تقطن في منتصف الغابات الجبلية في وسط غينيا الجديدة. قوتها الأساسي الفواكه والمفصليات."]},"enwiki":"Carola's parotia","image":{"file":"Parotia carolae by Bowdler Sharpe.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/8/8d/Parotia_carolae_by_Bowdler_Sharpe.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/8/8d/Parotia_carolae_by_Bowdler_Sharpe.jpg","page":"https://commons.wikimedia.org/wiki/File:Parotia_carolae_by_Bowdler_Sharpe.jpg","author":"Richard Bowdler Sharpe","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1080361","ar":"رفول غربي","sci":"Parotia sefilata","en":"Parotia sefilata","iucn":"LC","wdrev":2534006073,"head":"رفول","root":null,"arwiki":{"title":"رفول غربي","rev":69331508,"text":["رفول غربي (الاسم العلمي: Parotia sefilata)، طائر متوسط القد يطول حوالي 33 سم، مع ذيل متوسط الطول، وهي تنتمي إلى فصيلة طائر الجنة. أعطانها بابوا غينيا الجديدة وإندونيسيا."]},"enwiki":"Western parotia","image":{"file":"Parotia sefilata by Bowdler Sharpe.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/fd/Parotia_sefilata_by_Bowdler_Sharpe.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/f/fd/Parotia_sefilata_by_Bowdler_Sharpe.jpg","page":"https://commons.wikimedia.org/wiki/File:Parotia_sefilata_by_Bowdler_Sharpe.jpg","author":"Richard Bowdler Sharpe","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q386041","ar":"رفول قلزي","sci":"Parotia berlepschi","en":"Parotia berlepschi","iucn":"LC","wdrev":2534005965,"head":"رفول","root":null,"arwiki":{"title":"رفول قلزي","rev":69331004,"text":["رفول قُلزي أو رفول برونزي (الاسم العلمي: Parotia berlepschi)، نوع من الطيور المنتمية إلى جنس الرفول وفصيلة طائر الجنة. تقطن جبال فوجا في بابوا، إندونيسيا."]},"enwiki":"Bronze parotia","image":{"file":"Bronze Parotia (Parotia berlepschi) (cropped).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/d/df/Bronze_Parotia_%28Parotia_berlepschi%29_%28cropped%29.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/d/df/Bronze_Parotia_%28Parotia_berlepschi%29_%28cropped%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Bronze_Parotia_(Parotia_berlepschi)_(cropped).jpg","author":"Pagodroma721","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1585280","ar":"رفول لاويس","sci":"Parotia lawesii","en":"Lawes's Parotia","iucn":"LC","wdrev":2534006101,"head":"رفول","root":null,"arwiki":{"title":"رفول لاويس","rev":68666687,"text":["رفول لاويس (الاسم العلمي: Parotia lawesii)، طائر متوسط القد (يصل طولها إلى 27 سم) ينتمي إلى فصيلة طائر الجنة. يستوطن الغابات الجبلية في جنوب شرق وشرق بابوا غينيا الجديدة."]},"enwiki":"Lawes's parotia","image":{"file":"Parotia lawesii by Bowdler Sharpe.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/5/51/Parotia_lawesii_by_Bowdler_Sharpe.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/5/51/Parotia_lawesii_by_Bowdler_Sharpe.jpg","page":"https://commons.wikimedia.org/wiki/File:Parotia_lawesii_by_Bowdler_Sharpe.jpg","author":"Richard Bowdler Sharpe","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q2495357","ar":"رفول واهنس","sci":"Parotia wahnesi","en":"Wahnes's Parotia","iucn":"NT","wdrev":2534006117,"head":"رفول","root":null,"arwiki":{"title":"رفول واهنس","rev":73425921,"text":["رفول واهنس (الاسم العلمي: Parotia wahnesi)، طائر متوسط القد من فصيلة طائر الجنة. يستوطن الغابات الجبلية في شبه جزيرة هوون وجبال أدلبرت، شمال شرق بابوا غينيا الجديدة. النظام الغذائي يتكون بشكل أساسي من الفواكه والمفصليات.","هذه النوع سُمي على عالم الطبيعة الألماني كارل واهنس تكريمًا له، الذي كان يجمع الطيور في غينيا الجديدة."]},"enwiki":"Wahnes's parotia","image":{"file":"ParotiaWahnesiGronvold.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/0/07/ParotiaWahnesiGronvold.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/07/ParotiaWahnesiGronvold.jpg/960px-ParotiaWahnesiGronvold.jpg","page":"https://commons.wikimedia.org/wiki/File:ParotiaWahnesiGronvold.jpg","author":"Henrik Grønvold","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q795542","ar":"طائر الجنة الأحمر","sci":"Paradisaea rubra","en":"Red Bird-of-paradise","iucn":"NT","wdrev":2538998027,"head":"طاير","root":null,"arwiki":{"title":"طائر الجنة الأحمر","rev":69331501,"text":["طائر الجنة الأحمر أو طائر الفردوس الأحمر (الاسم العلمي Paradisaea rubra)، طائر من جنس طائر الفردوس وفصيلة الفردوسيات. طوله نحو 33 سم. موطنه إندونيسيا في جزيرة وايجيو وجزيرة باتانتا وجزر راجا أمبات، ومقاطعة بابوا الغربية. موائله الطبيعية الغابات المطيرة المنخفضة."]},"enwiki":"Red bird-of-paradise","image":{"file":"Paradisaea rubra-20090516.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/7/7c/Paradisaea_rubra-20090516.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/7/7c/Paradisaea_rubra-20090516.jpg","page":"https://commons.wikimedia.org/wiki/File:Paradisaea_rubra-20090516.jpg","author":"Doug Janson","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q769167","ar":"طائر الجنة الإمبراطوري","sci":"Paradisaea guilielmi","en":"Paradisaea guilielmi","iucn":"NT","wdrev":2538995211,"head":"طاير","root":null,"arwiki":{"title":"طائر الجنة الإمبراطوري","rev":68666729,"text":["طائر الجنة الإمبراطوري (الاسم العلمي Paradisaea guilielmi)، طائر من طائر الفردوس وفصيلة الفردوسيات. موطنه بابوا غينيا الجديدة. موائله الطبيعية التلال الغابية في شبه جزيرة الهون. قوته الفواكه والمفصليات."]},"enwiki":"Emperor bird-of-paradise","image":{"file":"Paradisaea guilielmi Museum de Genève.JPG","src":"https://upload.wikimedia.org/wikipedia/commons/0/09/Paradisaea_guilielmi_Museum_de_Gen%C3%A8ve.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Paradisaea_guilielmi_Museum_de_Gen%C3%A8ve.JPG/960px-Paradisaea_guilielmi_Museum_de_Gen%C3%A8ve.JPG","page":"https://commons.wikimedia.org/wiki/File:Paradisaea_guilielmi_Museum_de_Gen%C3%A8ve.JPG","author":"Totodu74","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q332621","ar":"طائر الجنة الصغير","sci":"Paradisaea minor","en":"Paradisaea minor","iucn":"LC","wdrev":2553436983,"head":"طاير","root":null,"arwiki":{"title":"طائر الجنة الصغير","rev":68666683,"text":["طائر الجنة الصغير (الاسم العلمي Paradisaea minor)، طائر من طائر الفردوس وفصيلة الفردوسيات. طوله نحو 32 سم. أعطانه الغابات الشمالية في غينيا الجديدة، والجزر القريبة من جزيرة ميسول وجزيرة يابن."]},"enwiki":"Lesser bird-of-paradise","image":{"file":"Lesser Bird of Paradise.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/64/Lesser_Bird_of_Paradise.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/6/64/Lesser_Bird_of_Paradise.jpg","page":"https://commons.wikimedia.org/wiki/File:Lesser_Bird_of_Paradise.jpg","author":"","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q325356","ar":"طائر الجنة الكبير","sci":"Paradisaea apoda","en":"Paradisaea apoda","iucn":"LC","wdrev":2538982723,"head":"طاير","root":null,"arwiki":{"title":"طائر الجنة الكبير","rev":76375286,"text":["طائر الجنة الكبير (الاسم العلمي Paradisaea apoda)، نوع طائر من جنس طائر الفردوس وفصيلة الفردوسيات. يصل طول الذكر نحو 43 سم والأنثى 35 سم. موطنه إندونيسيا وجنوب غرب غينيا الجديدة."]},"enwiki":"Greater bird-of-paradise","image":{"file":"Paradisaea apoda -Bali Bird Park-5.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/c/c1/Paradisaea_apoda_-Bali_Bird_Park-5.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c1/Paradisaea_apoda_-Bali_Bird_Park-5.jpg/960px-Paradisaea_apoda_-Bali_Bird_Park-5.jpg","page":"https://commons.wikimedia.org/wiki/File:Paradisaea_apoda_-Bali_Bird_Park-5.jpg","author":"Andrea Lawardi","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q590788","ar":"طائر الجنة غولدي","sci":"Paradisaea decora","en":"Goldie's Bird-of-paradise","iucn":"VU","wdrev":2549141211,"head":"طاير","root":null,"arwiki":{"title":"طائر الجنة غولدي","rev":68666749,"text":["طائر الجنة غولدي (الاسم العلمي Paradisaea decora)، طائر من طائر الفردوس وفصيلة الفردوسيات. أعطانه أرخبيل دانترا کاسترو، والجزر الشرقية لبابوا غينيا الجديدة. قوته الرئيسي الفواكه. طوله نحو 33 سم. سُمي بالغولدي نسبةً إلى جامع الطيور الإسكتلندي أندرو غولدي الذي أكتشف الطائر عام 1882. وهو ضمن القائمة الحمراء للأنواع المهددة بالانقراض. بسبب فقدان موائله الطبيعية."]},"enwiki":"Goldie's bird-of-paradise","image":{"file":"Paradisaea decora by Bowdler Sharpe.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/f2/Paradisaea_decora_by_Bowdler_Sharpe.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/f/f2/Paradisaea_decora_by_Bowdler_Sharpe.jpg","page":"https://commons.wikimedia.org/wiki/File:Paradisaea_decora_by_Bowdler_Sharpe.jpg","author":"Richard Bowdler Sharpe","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q795560","ar":"طائر الجنة ملك سكسونيا","sci":"Pteridophora alberti","en":"King of Saxony Bird-of-paradise","iucn":"LC","wdrev":2538998077,"head":"طاير","root":null,"arwiki":{"title":"طائر الجنة ملك سكسونيا","rev":72301086,"text":["طائر الجنة ملك سكسونيا (الاسم العلمي Pteridophora alberti)، طائر من فصيلة طائر الجنة. هو العضو الوحيد في جنس الرَّمَّاح (Pteridophora). إنهُ يَستوطن الغابات الجبلية في غينيا الجديدة."]},"enwiki":"King of Saxony bird-of-paradise","image":{"file":"Pteridophora alberti -Papua New Guinea-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/f3/Pteridophora_alberti_-Papua_New_Guinea-8.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/f/f3/Pteridophora_alberti_-Papua_New_Guinea-8.jpg","page":"https://commons.wikimedia.org/wiki/File:Pteridophora_alberti_-Papua_New_Guinea-8.jpg","author":"markaharper1","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q25260858","ar":"مانوكود بواق","sci":"Phonygammus keraudrenii","en":"Trumpet Manucode","iucn":"LC","wdrev":2534010526,"head":"مانوكود","root":null,"arwiki":{"title":"مانوكود بواق","rev":68666716,"text":["مانوكود بواق (الاسم العلمي: Phonygammus keraudrenii)،نوع من الطيور يتبع فصيلة طائر الجنة.","سُمي بالبواق بسبب أصواتها البوقية القوية والعالية. الاسم العلمي أُهدي أحياءً لذكرى طبيب البحرية الفرنسية بيير فرانسوا كيروودن (1769-1858).","ينتشر هذا النوع على نطاق واسع في جميع أنحاء الغابات المطيرة في شمال شبه جزيرة كيب يورك وغينيا الجديدة وجزر آرو. هذا النوع أحادي الزواج."]},"enwiki":"Trumpet manucode","image":{"file":"Manucodia keraudrenii bis by Bowdler Sharpe.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/5/5a/Manucodia_keraudrenii_bis_by_Bowdler_Sharpe.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/5/5a/Manucodia_keraudrenii_bis_by_Bowdler_Sharpe.jpg","page":"https://commons.wikimedia.org/wiki/File:Manucodia_keraudrenii_bis_by_Bowdler_Sharpe.jpg","author":"Richard Bowdler Sharpe","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1471944","ar":"مانوكود جعدي التاج","sci":"Manucodia comrii","en":"Curl-crested Manucode","iucn":"LC","wdrev":2534001509,"head":"مانوكود","root":null,"arwiki":{"title":"مانوكود جعدي التاج","rev":68666718,"text":["مانوكود جعدي التاج (الاسم العلمي: )، نوع من المانوكود وفصيلة طائر الجنة. موطنه في غينيا الجديدة."]},"enwiki":"Curl-crested manucode","image":{"file":"Manucodia comrii by Bowdler Sharpe.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/1/17/Manucodia_comrii_by_Bowdler_Sharpe.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/1/17/Manucodia_comrii_by_Bowdler_Sharpe.jpg","page":"https://commons.wikimedia.org/wiki/File:Manucodia_comrii_by_Bowdler_Sharpe.jpg","author":"Richard Bowdler Sharpe","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1590703","ar":"مانوكود جعدي الطوق","sci":"Manucodia chalybatus","en":"Crinkle-collared Manucode","iucn":"LC","wdrev":2534001514,"head":"مانوكود","root":null,"arwiki":{"title":"مانوكود جعدي الطوق","rev":68666714,"text":["مانوكود جعدي الطوق (الاسم العلمي: Manucodia chalybatus)، نوع من المانوكود وفصيلة طائر الجنة.","ينتشر في جميع أنحاء الأراضي المنخفضة وغابات التلال في البر الرئيسي لغينيا الجديدة وجزيرة ميسول بابوا الغربية. نظامه الغذائي يتكون بشكل أساسي من الفواكه والتين."]},"enwiki":"Crinkle-collared manucode","image":{"file":"Manucodia chalybatus 341061018.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/b/b1/Manucodia_chalybatus_341061018.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b1/Manucodia_chalybatus_341061018.jpg/960px-Manucodia_chalybatus_341061018.jpg","page":"https://commons.wikimedia.org/wiki/File:Manucodia_chalybatus_341061018.jpg","author":"Jean-Paul Boerekamps","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q305284","ar":"مانوكود جوبي","sci":"Manucodia jobiensis","en":"Jobi Manucode","iucn":"LC","wdrev":2538982626,"head":"مانوكود","root":null,"arwiki":{"title":"مانوكود جوبي","rev":68666690,"text":["مانوكود جوبي (الاسم العلمي: Manucodia jobiensis)، نوع من المانوكود وفصيلة طائر الجنة.","ينتشر في غابات الأراضي المنخفضة في جزيرة جوبي وشمال غينيا الجديدة. نظامه الغذائي يتكون بشكل أساسي من الفواكه والمفصليات. وهو كبافي أنواع المانوكود، أحادي الزواج.","وهو واحد من أكثر طيور الجنة شيوعًا في نطاقه."]},"enwiki":"Jobi manucode","image":null,"audio":null,"audioFromSearch":false,"video":null},{"id":"Q907786","ar":"مانوكود لماع","sci":"Manucodia ater","en":"Glossy-mantled Manucode","iucn":"LC","wdrev":2539002087,"head":"مانوكود","root":null,"arwiki":{"title":"مانوكود لماع","rev":74224672,"text":["مانوكود لماع (الاسم العلمي: Manucodia ater)، نوع من المانوكود وفصيلة طائر الجنة.","كان المانوكود اللماع أول طائر من طيور الجنة التي واجها عالم الطبيعة الفرنسي رينيه ليسن، وهو أول غربي يرى طيور الجنة البرية الحية. أعطانها في غينيا الجديدة"]},"enwiki":"Glossy-mantled manucode","image":{"file":"Manucodia ater.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/e/e9/Manucodia_ater.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e9/Manucodia_ater.jpg/960px-Manucodia_ater.jpg","page":"https://commons.wikimedia.org/wiki/File:Manucodia_ater.jpg","author":"Daniel Giraud Elliot","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1585268","ar":null,"sci":"Astrapia mayeri","en":"Ribbon-tailed Astrapia","iucn":"LC","wdrev":2534003560,"head":null,"root":null,"arwiki":null,"enwiki":"Ribbon-tailed astrapia","image":{"file":"Ribbon-tailed Astrapia - Papua New Guinea (19981314929).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/2/25/Ribbon-tailed_Astrapia_-_Papua_New_Guinea_%2819981314929%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/25/Ribbon-tailed_Astrapia_-_Papua_New_Guinea_%2819981314929%29.jpg