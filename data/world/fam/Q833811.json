{"id":"Q833811","sci":"Malaconotidae","ar":"دقناش الشجر","ord":{"id":"Q25341","sci":"Passeriformes","ar":"جواثم"},"birds":[{"id":"Q27075303","ar":"أخطب أرأس","sci":"Tchagra senegalus","en":"Black-crowned Tchagra","iucn":"LC","wdrev":2534015841,"head":"اخطب","root":null,"arwiki":{"title":"أخطب أرأس","rev":76374368,"text":["الأخطب الأرأس (الاسم العلمي: Tchagra senegalus) هو طائر من فصيلة دقناشات الشُجيرات، وترتبط هذه فصيلة الجواثم هذه ارتباطًا وثيقًا بالصُردان الحقيقية والتي كانت تُعد جزءًا منها سابقًا.","يوجد هذا النوع في شبه الجزيرة العربية ومعظم أفريقيا في الغابات المكشوفة والموائل شبه الصحراوية والمناطق الزراعية."]},"enwiki":"Black-crowned tchagra","image":{"file":"Black-crowned Tchagra, Tchagra senegala.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/6c/Black-crowned_Tchagra%2C_Tchagra_senegala.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/Black-crowned_Tchagra%2C_Tchagra_senegala.jpg/960px-Black-crowned_Tchagra%2C_Tchagra_senegala.jpg","page":"https://commons.wikimedia.org/wiki/File:Black-crowned_Tchagra,_Tchagra_senegala.jpg","author":"Derek Keats (https://www.flickr.com/photos/dkeats )","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":{"file":"Black-crowned Tchagra (Tchagra senegalus) (022A-WA03044X0029-0006M0).ogg","src":"https://upload.wikimedia.org/wikipedia/commons/6/64/Black-crowned_Tchagra_%28Tchagra_senegalus%29_%28022A-WA03044X0029-0006M0%29.ogg","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wiki/File:Black-crowned_Tchagra_(Tchagra_senegalus)_(022A-WA03044X0029-0006M0).ogg","author":"British Library","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","origin":null},"audioFromSearch":false,"video":null},{"id":"Q1028439","ar":"دقام قرمزي","sci":"Laniarius barbarus","en":"Yellow-crowned Gonolek","iucn":"LC","wdrev":2539003040,"head":"دقام","root":null,"arwiki":{"title":"دقام قرمزي","rev":76375362,"text":["دَقَّام قِرْمِزي هو طائر عابر متوسط الحجم من جنس الدقام في الفصيلة الدقناشية. الدقام القرمزي طائر متكاثر مقيم بشكل شائع في إفريقيا الاستوائية من السنغال وجمهورية الكونغو الديمقراطية شرقًا إلى إثيوبيا. إنه طائر متهور ويتردد على شجيرات كثيفة في الغابات وغيرها من الموائل المشجرة. العش هيكل كوبي في شجيرة أو شجرة توضع فيها بيضتان."]},"enwiki":"Yellow-crowned gonolek","image":{"file":"Bwbw barbari Laniarius barbarus.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/6a/Bwbw_barbari_Laniarius_barbarus.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Bwbw_barbari_Laniarius_barbarus.jpg/960px-Bwbw_barbari_Laniarius_barbarus.jpg","page":"https://commons.wikimedia.org/wiki/File:Bwbw_barbari_Laniarius_barbarus.jpg","author":"Alun Williams333","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1310754","ar":"دقناش الشجر الأولوغورو","sci":"Malaconotus alius","en":"Uluguru Bushshrike","iucn":null,"wdrev":2534015714,"head":"دقناش","root":null,"arwiki":{"title":"دقناش الشجر الأولوغورو","rev":76814058,"text":["دقناش أو طائر الأولوغورو ( Malaconotus alius )- هو نوع نادر من الطيور لا يوجد إلا في جبال الأولوغورو بإقليم موروغورو في تنزانيا. اكتُشف هذا الطائر عام 1926، وكان معروفًا آنذاك بأنه متواجد حصريًا في موقع واحد فقط، وهو محمية غابة أولوغورو الشمالية التي تبلغ مساحتها حوالي 84 كيلومتر مربع . ومع ذلك، وفي مارس 2007، اكتشف فريق من جمعية حماية الحياة البرية في تنزانيا وجود هذا الطائر في محمية غابة أولوغورو الجنوبية في منطقة موروغورو. ويُقدّر عدد الأزواج المتبقية بحوالي 1200 زوج، ويُعد اتجاه تعدادها مستقرًا."]},"enwiki":"Uluguru bushshrike","image":null,"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1303970","ar":"دقناش وردي الصدر","sci":"Rhodophoneus cruentus","en":"Rosy-patched Bushshrike","iucn":"LC","wdrev":2534013836,"head":"دقناش","root":null,"arwiki":{"title":"دقناش وردي الصدر","rev":75138150,"text":["دقناش وردي الصدر (الاسم العلمي: Rhodophoneus  cruentus) (الإنجليزية: Rosy-patched Bushshrike) هو طائر ينتمي إلى دقناش الشجر(فصيلة: Malaconotidae)."]},"enwiki":"Rosy-patched bushshrike","image":{"file":"Rosy-patched Bushshrike, Tarangire, Tanzania (8495915092).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/c/c6/Rosy-patched_Bushshrike%2C_Tarangire%2C_Tanzania_%288495915092%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Rosy-patched_Bushshrike%2C_Tarangire%2C_Tanzania_%288495915092%29.jpg/960px-Rosy-patched_Bushshrike%2C_Tarangire%2C_Tanzania_%288495915092%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Rosy-patched_Bushshrike,_Tarangire,_Tanzania_(8495915092).jpg","author":"Nigel Voaden from UK","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":{"file":"Rosy-patched Bushshrike (Rhodophoneus cruentus) (022A-WA03044X0030-0001M0).ogg","src":"https://upload.wikimedia.org/wikipedia/commons/3/32/Rosy-patched_Bushshrike_%28Rhodophoneus_cruentus%29_%28022A-WA03044X0030-0001M0%29.ogg","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wiki/File:Rosy-patched_Bushshrike_(Rhodophoneus_cruentus)_(022A-WA03044X0030-0001M0).ogg","author":"British Library","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","origin":null},"audioFromSearch":false,"video":null},{"id":"Q27075300","ar":null,"sci":"Bocagia minuta","en":"Bocagia minuta","iucn":"LC","wdrev":2534015837,"head":null,"root":null,"arwiki":null,"enwiki":"Marsh tchagra","image":{"file":"Marsh Tchagra, Luita, DRC (6700728549).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Marsh_Tchagra%2C_Luita%2C_DRC_%286700728549%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/Marsh_Tchagra%2C_Luita%2C_DRC_%286700728549%29.jpg/960px-Marsh_Tchagra%2C_Luita%2C_DRC_%2