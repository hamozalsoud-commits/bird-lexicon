{"id":"Q788536","sci":"Podargidae","ar":"فم الضفدع","ord":{"id":"Q108117338","sci":"Podargiformes","ar":null},"birds":[{"id":"Q594323","ar":"فم الصفدع الفلبيني","sci":"Batrachostomus septimus","en":"Philippine Frogmouth","iucn":"LC","wdrev":2549146907,"head":"فم","root":null,"arwiki":{"title":"فم الصفدع الفلبيني","rev":61784457,"text":["فم الصفدع الفلبيني (الاسم العلمي: Philippine frogmouth)، هو نوع من الطيور يتبع  فصيلة فم الضفدع ضمن رتبة السبديات. يستوطن الفلبين. ويتغذى على الصراصير والجراد والخنافس."]},"enwiki":"Philippine frogmouth","image":{"file":"Batrachostomus septimus 01.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/3/32/Batrachostomus_septimus_01.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/32/Batrachostomus_septimus_01.jpg/960px-Batrachostomus_septimus_01.jpg","page":"https://commons.wikimedia.org/wiki/File:Batrachostomus_septimus_01.jpg","author":"Joseph Smit","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q788512","ar":"فم الضفدع الأسمر","sci":"Podargus strigoides","en":"Tawny Frogmouth","iucn":"LC","wdrev":2554186437,"head":"فم","root":null,"arwiki":{"title":"فم الضفدع الأسمر","rev":73251219,"text":["فم الضفدع الأسمر (الاسم العلمي: Podargus strigoides)، هو نوع من الطيور الليلية يتبع فصيلة الفم الضفدع ضمن رتبة السبديات. وهو طائرٌ لاحمٌ يألف العيش في الغابات الاستوائية ويوجد بكثرة في أستراليا وتسمانيا وبابوا غينيا الجديدة ويقتات باللافقاريات والحيوانات البرمائية الصغيرة والقوارض.","يصنع عشه من الأغصان الصغيرة الساقطة ويضعه على الأشجار حيث تضع فيه الأنثى بيضة أو بيضتين يحضنها الأبوان لمدة 30 يوماً وبعد التفقيس تبقى الفراخ في العش لمدة طويلة. وله ذيل طويل مستدق وله ساقان قصيران وضعيفان ومنقاره ذو طرف محدب، العينان تقعان في مقدمة الرأس والريش بلون بني رمادي ومبقع بالأبيض والبني.","يعتبر أحد أفضل الطيّور في التخفي، إذ يبدو في كثير من الأحيان كأنه غصن مُتدلي من شجرة بسبب لونه المُتشابه مع الأغصان الأخرى."]},"enwiki":"Tawny frogmouth","image":{"file":"Podargus strigoides Bonorong.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/c/c4/Podargus_strigoides_Bonorong.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/Podargus_strigoides_Bonorong.jpg/960px-Podargus_strigoides_Bonorong.jpg","page":"https://commons.wikimedia.org/wiki/File:Podargus_strigoides_Bonorong.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1190032","ar":"فم الضفدع البابواني","sci":"Podargus papuensis","en":"Papuan Frogmouth","iucn":"LC","wdrev":2554188304,"head":"فم","root":null,"arwiki":{"title":"فم الضفدع البابواني","rev":67831160,"text":["فم الضفدع البابواني (الاسم العلمي: Podargus papuensis)، هو أكبر أنواع فصيلة فم الضفدع من حيث الطول، حيث يبلغ طوله في المتوسط حوالي 53 سم، يتميز عن أنواع جنسه وفصيلته بالطول كما أنه يتشابه معهم في لون الأعين الحمراء ولون الأجنحة. يتواجد في أستراليا وبابوا غينيا الجديدة وأندونيسيا. كما أنه بارع جداً في الاختفاء بسبب تشابه جسمه ولونه مع الأغصان."]},"enwiki":"Papuan frogmouth","image":{"file":"Podargus papuensis -Papuan Frogmouth-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/69/Podargus_papuensis_-Papuan_Frogmouth-8.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Podargus_papuensis_-Papuan_Frogmouth-8.jpg/960px-Podargus_papuensis_-Papuan_Frogmouth-8.jpg","page":"https://commons.wikimedia.org/wiki/File:Podargus_papuensis_-Papuan_Frogmouth-8.jpg","author":"markaharper1","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q261612","ar":"فم الضفدع الرخامي","sci":"Podargus ocellatus","en":"Marbled Frogmouth","iucn":"LC","wdrev":2541315549,"head":"فم","root":null,"arwiki":{"title":"فم الضفدع الرخامي","rev":68160471,"text":["فم الضفدع الرخامي (الاسم العلمي: Podargus ocellatus)، هو نوع من الطيور يتبع فصيلة فم الضفدع ضمن رتبة السبديات. تتواجد في أستراليا وبابوا غينيا الجديدة وجزر سليمان وأندونيسيا."]},"enwiki":"Marbled frogmouth","image":{"file":"Podargus ocellatus -Redwood -Queensland-8.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/a/ac/Podargus_ocellatus_-Redwood_-Queensland-8.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/a/ac/Podargus_ocellatus_-Redwood_-Queensland-8.jpg","page":"https://commons.wikimedia.org/wiki/File:Podargus_ocellatus_-Redwood_-Queensland-8.jpg","author":"The original uploader was Bauple58 at English Wikipedia.","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1267780","ar":"فم الضفدع السريلانكي","sci":"Batrachostomus moniliger","en":"Sri Lanka Frogmouth","iucn":"LC","wdrev":2533954809,"head":"فم","root":null,"arwiki":{"title":"فم الضفدع السريلانكي","rev":61784486,"text":["فم الضفدع السريلانكي (الاسم العلمي: Batrachostomus moniliger)، هو نوع من الطيور يتبع فصيلة فم الضفدع ضمن رتبة السبديات. يستوطن جنوب الهند وسريلانكا."]},"enwiki":"Sri Lanka frogmouth","image":{"file":"Srilankan Frogmouth RJM 8824.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/7/77/Srilankan_Frogmouth_RJM_8824.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/77/Srilankan_Frogmouth_RJM_8824.jpg/960px-Srilankan_Frogmouth_RJM_8824.jpg","page":"https://commons.wikimedia.org/wiki/File:Srilankan_Frogmouth_RJM_8824.jpg","author":"Renjuuu","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":{"file":"Ceylon frogmouth.ogg","src":"https://upload.wikimedia.org/wikipedia/commons/1/18/Ceylon_frogmouth.ogg","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wiki/File:Ceylon_frogmouth.ogg","author":"L. Shyamal","license":"CC BY-SA 3.0","licenseUrl":"https://creativec