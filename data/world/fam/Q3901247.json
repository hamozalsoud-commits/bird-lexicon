enses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q83022790","ar":"غاق بحري","sci":"Urile pelagicus","en":"Pelagic Cormorant","iucn":"LC","wdrev":2553948849,"head":"غاق","root":null,"arwiki":{"title":"غاق بحري","rev":68264698,"text":["غاق بحري (الاسم العلمي: Phalacrocorax pelagicus) هو نوع من جنس غاق."]},"enwiki":"Pelagic cormorant","image":{"file":"Pelagic Cormorant (Phalacrocorax pelagicus) at Monterey Bay.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/e/e3/Pelagic_Cormorant_%28Phalacrocorax_pelagicus%29_at_Monterey_Bay.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/e/e3/Pelagic_Cormorant_%28Phalacrocorax_pelagicus%29_at_Monterey_Bay.jpg","page":"https://commons.wikimedia.org/wiki/File:Pelagic_Cormorant_(Phalacrocorax_pelagicus)_at_Monterey_Bay.jpg","author":"Alan Vernon","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q117254632","ar":"غاق برازيلي","sci":"Nannopterum brasilianum","en":"Neotropic cormorant","iucn":"LC","wdrev":2556100890,"head":"غاق","root":null,"arwiki":{"title":"غاق برازيلي","rev":68443955,"text":["غاق برازيلي (الاسم العلمي: Phalacrocorax brasilianus) هو نوع من الطيور يتبع جنس الغاق من الفصيلة الغاقيات."]},"enwiki":"Neotropic cormorant","image":{"file":"Phalacrocorax brasilianus (Costa Rica).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/0/0e/Phalacrocorax_brasilianus_%28Costa_Rica%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0e/Phalacrocorax_brasilianus_%28Costa_Rica%29.jpg/960px-Phalacrocorax_brasilianus_%28Costa_Rica%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Phalacrocorax_brasilianus_(Costa_Rica).jpg","author":"Hans Hillewaert","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q83022912","ar":"غاق برانت","sci":"Urile penicillatus","en":"Brandt's Cormorant","iucn":"LC","wdrev":2542479782,"head":"غاق","root":null,"arwiki":{"title":"غاق برانت","rev":68444108,"text":["غاق برانت (الاسم العلمي: Phalacrocorax penicillatus) هو نوع من جنس غاق."]},"enwiki":"Brandt's cormorant","image":{"file":"Cormorant03262006a.JPG","src":"https://upload.wikimedia.org/wikipedia/commons/b/ba/Cormorant03262006a.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/Cormorant03262006a.JPG/960px-Cormorant03262006a.JPG","page":"https://commons.wikimedia.org/wiki/File:Cormorant03262006a.JPG","author":"No machine-readable author provided. Miskatonic assumed (based on copyright claims).","license":"CC BY 2.5","licenseUrl":"https://creativecommons.org/licenses/by/2.5","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q25640","ar":"غاق داكن","sci":"Phalacrocorax fuscescens","en":"Black-faced Cormorant","iucn":"LC","wdrev":2539118680,"head":"غاق","root":null,"arwiki":{"title":"غاق داكن","rev":73251226,"text":["غاق داكن (الاسم العلمي: Phalacrocorax fuscescens) هو نوع من الطيور يتبع جنس الغاق من الفصيلة الغاقيات."]},"enwiki":"Black-faced cormorant","image":{"file":"Phalacrocorax fuscescens - Derwent River Estuary.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/4/41/Phalacrocorax_fuscescens_-_Derwent_River_Estuary.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Phalacrocorax_fuscescens_-_Derwent_River_Estuary.jpg/960px-Phalacrocorax_fuscescens_-_Derwent_River_Estuary.jpg","page":"https://commons.wikimedia.org/wiki/File:Phalacrocorax_fuscescens_-_Derwent_River_Estuary.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q838117","ar":"غاق ذو نظارة","sci":"Urile perspicillatus","en":"Spectacled Cormorant","iucn":"EX","wdrev":2554167171,"head":"غاق","root":null,"arwiki":{"title":"غاق ذو نظارة","rev":61581248,"text":["غاق ذو نظارة (الاسم العلمي: Phalacrocorax perspicillatus)، طائر بحري منقرض من فصيلةالغاقيات التي كانت تعيش في جزيرة بيرنغ وربما في أماكن أخرى في جزر القائد وساحل كامشاتكا في أقصى شمال شرق روسيا.","تبين أن التوزيع الحديث له كان توزيع أوسع لعصور ما قبل التاريخ في عام 2018 عُثر على أنواع أحفورية تعود لـ120،000 سنة مضت في اليابان. وهو أكبر أنواع الغاق المعروفة."]},"enwiki":"Spectacled cormorant","image":{"file":"Phalacrocorax perspicillatus.png","src":"https://upload.wikimedia.org/wikipedia/commons/d/de/Phalacrocorax_perspicillatus.png","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Phalacrocorax_perspicillatus.png/960px-Phalacrocorax_perspicillatus.png","page":"https://commons.wikimedia.org/wiki/File:Phalacrocorax_perspicillatus.png","author":"John Gerrard Keulemans","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q59472","ar":"غاق مكلل","sci":"Microcarbo coronatus","en":"Crowned Cormorant","iucn":"LC","wdrev":2557681602,"head":"غاق","root":null,"arwiki":{"title":"غاق مكلل","rev":68444106,"text":["غاق مكلل (الاسم العلمي: Phalacrocorax coronatus) هو نوع من الطيور يتبع جنس الغاق من الفصيلة الغاقيات."]},"enwiki":"Crowned cormorant","image":{"file":"Crowned Cormorant, Phalacrocorax coronatus.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/3/35/Crowned_Cormorant%2C_Phalacrocorax_coronatus.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Crowned_Cormorant%2C_Phalacrocorax_coronatus.jpg/960px-Crowned_Cormorant%2C_Phalacrocorax_coronatus.jpg","page":"https://commons.wikimedia.org/wiki/File:Crowned_Cormorant,_Phalacrocorax_coronatus.jpg","author":"Ryanvanhuyssteen","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q27074616","ar":"غاق منقط","sci":"Phalacrocorax punctatus","en":"Spotted Shag","iucn":"LC","wdrev":2542001027,"head":"غاق","root":null,"arwiki":{"title":"غاق منقط","rev":60759340,"text":["غاق منقط (الاسم العلمي: Phalacrocorax punctatus) هو نوع من الطيور يتبع جنس الغاق من الفصيلة الغاقيات."]},"enwiki":"Spotted shag","image":{"file":"Spotted Shag. NZ (Phalacrocorax punctatus). (29350774683).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/62/Spotted_Shag._NZ_%28Phalacrocorax_punctatus%29._%2829350774683%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Spotted_Shag._NZ_%28Phalacrocorax_punctatus%29._%2829350774683%29.jpg/960px-Spotted_Shag._NZ_%28Phalacrocorax_punctatus%29._%2829350774683%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Spotted_Shag._NZ_(Phalacrocorax_punctatus)._(29350774683).jpg","author":"Bernard Spragg. NZ from Christchurch, New Zealand","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q749326","ar":"غاق هندي","sci":"Phalacrocorax fuscicollis","en":"Indian Cormorant","iucn":"LC","wdrev":2557681533,"head":"غاق","root":null,"arwiki":{"title":"غاق هندي","rev":71012856,"text":["غاق هندي (الاسم العلمي: Phalacrocorax fuscicollis) هو نوع من جنس غاق."]},"enwiki":"Indian cormorant","image":{"file":"Indian Cormorant (Br.) I IMG 8092.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/6f/Indian_Cormorant_%28Br.%29_I_IMG_8092.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/6/6f/Indian_Cormorant_%28Br.%29_I_IMG_8092.jpg","page":"https://commons.wikimedia.org/wiki/File:Indian_Cormorant_(Br.)_I_IMG_8092.jpg","author":"J.M.Garg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q27074617","ar":"غاقة البيرو","sci":"Leucocarbo bougainvilliorum","en":"Guanay Cormorant","iucn":"NT","wdrev":2541530332,"head":"غاقة","root":null,"arwiki":{"title":"غاقة البيرو","rev":68340571,"text":["غاقة البيرو (الاسم العلمي: Leucocarbo bougainvilliorum)، نوع من الغاقيات الموجودة على ساحل المحيط الهادئ في البيرو وشمال تشيلي. (يبدو أن طائر غاقة البيرو في الأرجنتين على ساحل المحيط الأطلسي باتاغون قد انقرض.) بعد تكاثره ينتشر جنوبًا إلى الأجزاء الجنوبية من تشيلي ومن الشمال إلى الإكوادور، وقد تم تسجيله أيضًا في أقصى الشمال مثل بنما وكولومبيا - وربما كان ذلك نتيجة للانتشار الجماعي بسبب لنقص الغذاء في سنوات إل نينيو. وتشمل الموائله الرئيسية مياه البحر الضحلة والشواطئ الصخرية."]},"enwiki":"Guanay cormorant","image":{"file":"Leucocarbo bougainvillii, Islas Ballestas 5.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/b/b2/Leucocarbo_bougainvillii%2C_Islas_Ballestas_5.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/b/b2/Leucocarbo_bougainvillii%2C_Islas_Ballestas_5.jpg","page":"https://commons.wikimedia.org/wiki/File:Leucocarbo_bougainvillii,_Islas_Ballestas_5.jpg","author":"Bruno Girin from London, United Kingdom","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1002574","ar":"غاقة رأس الرجاء الصالح","sci":"Phalacrocorax capensis","en":"Cape Cormorant","iucn":null,"wdrev":2539043953,"head":"غاقة","root":null,"arwiki":{"title":"غاقة رأس الرجاء الصالح","rev":73442377,"text":["غاقة رأس الرجاء الصالح (الاسم العلمي: Phalacrocorax capensis)، نوع من الطيور المنتمية إلى فصيلة الغاقيات تستوطن سواحل جنوب غرب إفريقيا.","يمتد موئل تكاثرها من ناميبيا جنوبًا إلى جنوب كيب الغربية. في موسم التوالد، قد توجد في أقصى الشمال حتى مصب الكونغو، ويمتد أيضًا على الساحل الشرقي لجنوب إفريقيا حتى موزمبيق. في سبعينيات القرن العشرين، قُدر عددها بأكثر من مليون طائر في ناميبيا وحدها. ومع ذلك، فإن الاتحاد الدولي لحفظ الطبيعة يصنفها الآن على أنها «مهددة بالانقراض» بسبب الانخفاض السريع للغاية في اعدادها على مدى الأجيال الثلاثة الأخيرة."]},"enwiki":"Cape cormorant","image":{"file":"Cape Cormorant, Cape Town.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/2/25/Cape_Cormorant%2C_Cape_Town.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/25/Cape_Cormorant%2C_Cape_Town.jpg/960px-Cape_Cormorant%2C_Cape_Town.jpg","page":"https://commons.wikimedia.org/wiki/File:Cape_Cormorant,_Cape_Town.jpg","author":"D. Gordon E. Robertson","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q82955137","ar":"غاقة عاجزة عن الطيران","sci":"Nannopterum harrisi","en":"Flightless Cormorant","iucn":"VU","wdrev":2556099815,"head":"غاقة","root":null,"arwiki":{"title":"غاقة عاجزة عن الطيران","rev":68340572,"text":["الغاقة العاجزة عن الطيران وتعرف باسم غاقة غالاباغوس (الاسم العلمي: Nannopterum harrisi)، طائر من فصيلة الغاقيات. لا توجد إلا في جزيرتي فِرناندينا وإيزابلّا في أرخبيل غالاباغوس. إنهُ فريد من نوعه لأنه الغاق المعروف الوحيد الذي فقد القدرة على الطيران. يبلغ قده 89 سم."]},"enwiki":"Flightless cormorant","image":{"file":"Flightless Cormorant (Phalacrocorax harrisi) (19455799592).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/60/Flightless_Cormorant_%28Phalacrocorax_harrisi%29_%2819455799592%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/60/Flightless_Cormorant_%28Phalacrocorax_harrisi%29_%2819455799592%29.jpg/960px-Flightless_Cormorant_%28Phalacrocorax_harrisi%29_%2819455799592%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Flightless_Cormorant_(Phalacrocorax_harrisi)_(19455799592).jpg","author":"Lip Kee","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q244319","ar":"غاقة قزمة","sci":"Microcarbo pygmaeus","en":"Pygmy Cormorant","iucn":"LC","wdrev":2533958910,"head":"غاقة","root":null,"arwiki":{"title":"غاقة قزمة","rev":68443959,"text":["الغاقة القزم (الاسم العلمي: Phalacrocorax pygmeus) هو نوع من الطيور يتبع جنس الغاق من الفصيلة الغاقيات.","طوله 50 سم (60-62) ذو لون أسود مخضر ومبقع بالأبيض خلال الصيف ورأس بني محمر. المنقار أقصر من الخش المدوي. تتألف الحضنة من 2-4 بيوض، ويعشش وحيداً أو في مستعمرات مع غيره من أنواع البلشون. ويصنف بعض علماء الطيور هذا النوع في فصيلة Cochlearidae: التي لا تضم غيره، بينما طيور البلشون الأخرى تعتبر حقيقة."]},"enwiki":"Pygmy cormorant","image":{"file":"Microcarbo pygmeus - Pigmy Cormorant 01.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/f4/Microcarbo_pygmeus_-_Pigmy_Cormorant_01.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/Microcarbo_pygmeus_-_Pigmy_Cormorant_01.jpg/960px-Microcarbo_pygmeus_-_Pigmy_Cormorant_01.jpg","page":"https://commons.wikimedia.org/wiki/File:Microcarbo_pygmeus_-_Pigmy_Cormorant_01.jpg","author":"Zeynel Cebeci","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q25440","ar":"غاقة كبيرة","sci":"Phalacrocorax carbo","en":"Great Cormorant","iucn":"LC","wdrev":2548140287,"head":"غاقة","root":null,"arwiki":{"title":"غاق كبير","rev":76375006,"text":["الغاقة الكبيرة أو غراب البحر (الاسم العلمي: Phalacrocorax  carbo) (الإنجليزية: Great  Cormorant) هو طائر ينتمي إلى غاقيات (فصيلة: Phalacrocoracidae)."]},"enwiki":"Great cormorant","image":{"file":"Phalacrocorax carbo Vic.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/68/Phalacrocorax_carbo_Vic.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Phalacrocorax_carbo_Vic.jpg/960px-Phalacrocorax_carbo_Vic.jpg","page":"https://commons.wikimedia.org/wiki/File:Phalacrocorax_carbo_Vic.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":{"file":"Aalscholver op havenpaal-4676903.webm","src":"https://upload.wikimedia.org/wikipedia/commons/3/38/Aalscholver_op_havenpaal-4676903.webm","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Aalscholver_op_havenpaal-4676903.webm/960px--Aalscholver_op_havenpaal-4676903.webm.jpg","page":"https://commons.wikimedia.org/wiki/File:Aalscholver_op_havenpaal-4676903.webm","author":"Marc Plomp","license":"CC BY-SA 3.0 nl","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0/nl/deed.en","origin":null}},{"id":"Q632399","ar":"غراب البحر السقطري","sci":"Phalacrocorax nigrogularis","en":"Socotra Cormorant","iucn":"VU","wdrev":2538987282,"head":"غراب","root":"غ ر ب","arwiki":{"title":"غاق سقطري","rev":75258501,"text":["الغاق السقطري أو غراب البحر السوقطري (الاسم العلمي: Phalacrocorax  nigrogularis) (الإنجليزية: Socotra  Cormorant) هو طائر ينتمي إلى غاقيات (فصيلة: Phalacrocoracidae). كما تعرف أحيانا باسم الغاق السقطري وهو نوع من الطيور المهددة والمتوطنة في سقطرى والخليج العربي والساحل الجنوبي الشرقي لشبه","الجزيرة العربية تهاجر أحيانا إلى أقصى الغرب مثل ساحل البحر الأحمر و تتكاثر في جزر سقطرى في المحيط الهندي"]},"enwiki":"Socotra cormorant","image":{"file":"Socotra Cormorant.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/f4/Socotra_Cormorant.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/f/f4/Socotra_Cormorant.jpg","page":"https://commons.wikimedia.org/wiki/File:Socotra_Cormorant.jpg","author":"Nepenthes","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q83020448","ar":null,"sci":"Gulosus aristotelis","en":"European shag","iucn":"LC","wdrev":2556067974,"head":null,"root":null,"arwiki":{"title":"غاقة أوروبية","rev":76374976,"text":["الغاقة الأوروبية أو غاق شائع (الاسم العلمي: Phalacrocorax aristotelis) هو نوع من الطيور يتبع جنس الغاق من الفصيلة الغاقيات.","وهو بحجم الإوزة(90 سم) لون ريش الطيور البالغة أسود مع لمعان أخضر، الذقن أبيض وكذلك الوجنتان، والطيور الموجودة في العالم القديم عارية الحنجرة صفراء اللون. بينما الطيور الصغيرة بنية اللون مع بطن أبيض. يوجد في أوروبا وآسيا وأفريقيا وشمال شرقي كندا، وفي الشتاء في الولايات الأمريكية الوسطى الواقعة على الأطلسي."]},"enwiki":"European shag","image":{"file":"Shag Phalacrocorax aristotelis.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/63/Shag_Phalacrocorax_aristotelis.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Shag_Phalacrocorax_aristotelis.jpg/960px-Shag_Phalacrocorax_aristotelis.jpg","page":"https://commons.wikimedia.org/wiki/File:Shag_Phalacrocorax_aristotelis.jpg","author":"Andreas Trepte","license":"CC BY-SA 2.5","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.5","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q12262259","ar":null,"sci":"Leucocarbo atriceps","en":"Imperial Shag","iucn":"LC","wdrev":2542253566,"head":null,"root":null,"arwiki":{"title":"غاق إمبراطوري","rev":72430121,"text":["الغاقة الإمبراطورية (الاسم العلمي: Phalacrocorax atriceps) هو نوع من جنس غاق أزرق العينين."]},"enwiki":"Imperial shag","image":{"file":"Phalacrocorax atriceps2 B.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/6a/Phalacrocorax_atriceps2_B.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Phalacrocorax_atriceps2_B.jpg/960px-Phalacrocorax_atriceps2_B.jpg","page":"https://commons.wikimedia.org/wiki/File:Phalacrocorax_atriceps2_B.jpg","author":"Calyponte","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q27074621","ar":null,"sci":"Leucocarbo campbelli","en":"Campbell Shag","iucn":"VU","wdrev":2557681644,"head":null,"root":null,"arwiki":null,"enwiki":"Campbell shag","image":{"file":"Campbell Shag, Campbell Island 01.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/65/Campbell_Shag%2C_Campbell_Island_01.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/65/Campbell_Shag%2C_Campbell_Island_01.jpg/960px-Campbell_Shag%2C_Campbell_Island_01.jpg","page":"https://commons.wikimedia.org/wiki/File:Campbel