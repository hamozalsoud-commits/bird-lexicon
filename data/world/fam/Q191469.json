{"id":"Q191469","sci":"Trogonidae","ar":"نهاسية","ord":{"id":"Q14566629","sci":"Trogoniformes","ar":null},"birds":[{"id":"Q1270238","ar":"طرغونية برتقالية الصدر","sci":"Harpactes oreskios","en":"Orange-breasted Trogon","iucn":"LC","wdrev":2533977778,"head":"طرغونية","root":null,"arwiki":{"title":"نهاس برتقالي الصدر","rev":68264673,"text":["نهاس برتقالي الصدر (الاسم العلمي: Harpactes oreskios) هو نوع من الطيور يتبع الفصيلة النهاسبة."]},"enwiki":"Orange-breasted trogon","image":{"file":"Harpactes oreskios - Kaeng Krachan.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/1/14/Harpactes_oreskios_-_Kaeng_Krachan.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Harpactes_oreskios_-_Kaeng_Krachan.jpg/960px-Harpactes_oreskios_-_Kaeng_Krachan.jpg","page":"https://commons.wikimedia.org/wiki/File:Harpactes_oreskios_-_Kaeng_Krachan.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1261673","ar":"طرغونية قرمزية الأرداف","sci":"Harpactes duvaucelii","en":"Scarlet-rumped Trogon","iucn":"NT","wdrev":2533977730,"head":"طرغونية","root":null,"arwiki":{"title":"نهاس قرمزي الأرداف","rev":68264676,"text":["نهاس قرمزي الأرداف (الاسم العلمي: Harpactes duvaucelii) هو نوع من الطيور يتبع الفصيلة النهاسية."]},"enwiki":"Scarlet-rumped trogon","image":{"file":"HarpactesDuvauceliGould.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/f5/HarpactesDuvauceliGould.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/HarpactesDuvauceliGould.jpg/960px-HarpactesDuvauceliGould.jpg","page":"https://commons.wikimedia.org/wiki/File:HarpactesDuvauceliGould.jpg","author":"John Gould, HC Richter","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q459267","ar":"قتزال براق","sci":"Pharomachrus mocinno","en":"Resplendent Quetzal","iucn":"NT","wdrev":2559319233,"head":"قتزال","root":null,"arwiki":{"title":"قتزال براق","rev":68341045,"text":["القِتزال البراق أو الكَتزَل البَرَّاق طائرًا من فصيلة النهاسايت. يوجد هذا الطائر بدءًا من جنوب المكسيك حتى غرب بنما (بخلاف طيور القتزال الأخرى، والتي توجد في أمريكا الجنوبية وشرق بنما). وهو معروف جيدًا بريشه الغني بالألوان. هناك اثنتان من الفصائل الفرعية وهما ف. م. موكينو وف. م. كوستاريسينسز.","يلعب هذا القتزال دورًا مهمًا في أساطير وسط أمريكا. يعتبر القتزال المتألق طائر غواتيمالا القومي وتوجد له صورة على علم وشعار النبالة الغواتيمالي. كما أنه اسم العملة المحلية (المعروفة باسم GTQ اختصارًا)."]},"enwiki":"Resplendent quetzal","image":{"file":"Pharomachrus mocinno 189344785.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/9/9f/Pharomachrus_mocinno_189344785.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/9/9f/Pharomachrus_mocinno_189344785.jpg","page":"https://commons.wikimedia.org/wiki/File:Pharomachrus_mocinno_189344785.jpg","author":"Ariannis Pitti","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":{"file":"Pharomachrus mocinno Monteverde.ogv","src":"https://upload.wikimedia.org/wikipedia/commons/c/c9/Pharomachrus_mocinno_Monteverde.ogv","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Pharomachrus_mocinno_Monteverde.ogv/960px--Pharomachrus_mocinno_Monteverde.ogv.jpg","page":"https://commons.wikimedia.org/wiki/File:Pharomachrus_mocinno_Monteverde.ogv","author":"Cephas","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null}},{"id":"Q1006430","ar":"قتزال ذو الأذنين","sci":"Euptilotis neoxenus","en":"Eared Quetzal","iucn":"LC","wdrev":2539002909,"head":"قتزال","root":null,"arwiki":{"title":"قتزال ذو الأذنين","rev":72631144,"text":["قتزال ذو الأذنين (الاسم العلمي: Euptilotis neoxenus)، المعروف أيضًا باسم نهاس ذو الأذنين، هو طائر شبه جاثم ينتمي إلى فصيلة النهاسية. وموطنه الأصلي غابات الصنوبر والبلوط الواقعة على ضفاف الجداول، وكذلك الأخاديد في سلسلة جبال سييرا مادري الغربية في المكسيك، من شمالي سونورا وتشيواوا جنوبًا إلى غربي ميتشواكان. وقد ظهر هذا النوع في مناسبات نادرة في جنوب شرقي ولاية أريزونا بالولايات المتحدة، حيث تم تسجيل حالات تعشيش له."]},"enwiki":"Eared quetzal","image":{"file":"Euptilotis neoxenus 98997346.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/9/93/Euptilotis_neoxenus_98997346.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Euptilotis_neoxenus_98997346.jpg/960px-Euptilotis_neoxenus_98997346.jpg","page":"https://commons.wikimedia.org/wiki/File:Euptilotis_neoxenus_98997346.jpg","author":"Dario","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q374805","ar":"نهاس أحمر الرأس","sci":"Harpactes erythrocephalus","en":"Red-headed Trogon","iucn":"LC","wdrev":2538977705,"head":"نهاس","root":null,"arwiki":{"title":"نهاس أحمر الرأس","rev":68264674,"text":["نهاس أحمر الرأس (الاسم العلمي: Harpactes erythrocephalus) هو نوع من الفصيلة تلنهاسية."]},"enwiki":"Red-headed trogon","image":{"file":"Harpactes erythrocephalus - Khao Yai.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/69/Harpactes_erythrocephalus_-_Khao_Yai.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Harpactes_erythrocephalus_-_Khao_Yai.jpg/960px-Harpactes_erythrocephalus_-_Khao_Yai.jpg","page":"https://commons.wikimedia.org/wiki/File:Harpactes_erythrocephalus_-_Khao_Yai.jpg","author":"JJ Harrison (jjharrison89@facebook.com)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1263288","ar":"نهاس أحمر القفا","sci":"Harpactes kasumba","en":"Red-naped Trogon","iucn":"NT","wdrev":2540986649,"head":"نهاس","root":null,"arwiki":{"title":"نهاس أحمر القفا","rev":63777646,"text":["نهّاس أحمر 