{"id":"Q25365","sci":"Gruidae","ar":"كركية","ord":{"id":"Q25557","sci":"Gruiformes","ar":"كركيات الشكل"},"birds":[{"id":"Q756674","ar":"كركي أزرق","sci":"Anthropoides paradiseus","en":"blue crane","iucn":"VU","wdrev":2551293451,"head":"كركي","root":"ك ر ك","arwiki":{"title":"كركي أزرق","rev":75773179,"text":["الرَّوَّاد أو رَهُو الجنة أو الكركي الأزرق هو طائر ينتمي إلى الفصيلة الكركية، وهو الطائر الوطني لجنوب إفريقيا."]},"enwiki":"Blue crane","image":{"file":"Blue Cranes (Anthropoides paradiseus) couple (32611106035).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/7/79/Blue_Cranes_%28Anthropoides_paradiseus%29_couple_%2832611106035%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Blue_Cranes_%28Anthropoides_paradiseus%29_couple_%2832611106035%29.jpg/960px-Blue_Cranes_%28Anthropoides_paradiseus%29_couple_%2832611106035%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Blue_Cranes_(Anthropoides_paradiseus)_couple_(32611106035).jpg","author":"Bernard DUPONT from FRANCE","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q261445","ar":"كركي أسود المنقار","sci":"Grus nigricollis","en":"Black-necked Crane","iucn":"NT","wdrev":2559977451,"head":"كركي","root":"ك ر ك","arwiki":{"title":"كركي أسود المنقار","rev":68446085,"text":["كركي أسود المنقار (الاسم العلمي: Grus nigricollis) نوع من الطيور يتبع جنس الكركي من الفصيلة الكركية."]},"enwiki":"Black-necked crane","image":{"file":"Black necked crane at Hanle.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/e/e7/Black_necked_crane_at_Hanle.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Black_necked_crane_at_Hanle.jpg/960px-Black_necked_crane_at_Hanle.jpg","page":"https://commons.wikimedia.org/wiki/File:Black_necked_crane_at_Hanle.jpg","author":"Sumeetmoghe","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q457477","ar":"كركي أمريكي","sci":"Grus americana","en":"whooping crane","iucn":null,"wdrev":2549217652,"head":"كركي","root":"ك ر ك","arwiki":{"title":"كركي أمريكي","rev":76375343,"text":["كركي أمريكي أو الكركي الهتّاف (الاسم العلمي:Grus americana) (الإنجليزية: Whooping Crane) هو نوع من الطيور يتبع جنس الكركي من الفصيلة الكركية."]},"enwiki":"Whooping crane","image":{"file":"Grus americana Sasata.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/7/7f/Grus_americana_Sasata.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Grus_americana_Sasata.jpg/960px-Grus_americana_Sasata.jpg","page":"https://commons.wikimedia.org/wiki/File:Grus_americana_Sasata.jpg","author":"Sasata","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q191683","ar":"كركي سنجابي","sci":"Anthropoides virgo","en":"Anthropoides virgo","iucn":"LC","wdrev":2549043704,"head":"كركي","root":"ك ر ك","arwiki":{"title":"كركي سنجابي","rev":76375576,"text":["الكركي السنجابي أو الرهو أو أَدْبَج نَمِيدَة أو عَانِس نَمِيدَة (الاسم العلمي: Anthropoides  virgo) (الإنجليزية: Demoiselle  Crane) هو طائر ينتمي إلى فصيلة الكركي."]},"enwiki":"Demoiselle crane","image":{"file":"Demoiselle Cranes at Tal Chappar.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/c/c3/Demoiselle_Cranes_at_Tal_Chappar.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Demoiselle_Cranes_at_Tal_Chappar.jpg/960px-Demoiselle_Cranes_at_Tal_Chappar.jpg","page":"https://commons.wikimedia.org/wiki/File:Demoiselle_Cranes_at_Tal_Chappar.jpg","author":"Sumeet Moghe","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q21949185","ar":"كركي سيبيري","sci":"Leucogeranus leucogeranus","en":"Siberian Crane","iucn":"CR","wdrev":2533951959,"head":"كركي","root":"ك ر ك","arwiki":{"title":"كركي سيبيري","rev":68341422,"text":["الكركي السيبيري (Leucogeranus leucogeranus)، المعروف أيضا باسم الكركي السيبيري الأبيض أو كركي الثلج، هو طائر من عائلة الكركيات. يتميز الكركي السيبيري بين الكركيات بأن الطيور البالغة بيضاء كالثلج باستثناء الريش الأسود الذي يظهر في طيرانه. وتظهر الطيور في منطقتي تزاوج في تندرا القطب الشمالي عند غرب وشرق روسيا. وتهاجر الطيور الشرقية خلال فصل الشتاء إلى الصين، بينما تهاجر الغربية إلي إيران، وكانت تهاجر سابقا إلى الهند ونيبال. وهي صاحبة أطول مسافة هجرات بين فصيلة الكركيات. وقد انخفض تعدادها بشكل كبير في القرن العشرين، خاصة في المناطق الغربية، بسبب الصيد على طول طرق هجرتها وتدهور بيئة مواطنها. ويقدر تعدادها في عام 2010 بحوالي 3200 طائر، معظمها تنتمي إلى المنطقة الشرقية، وتعيش نحو 95 بالمائة منها في حوض بحيرة بويانغ في الصين، ويمكن أن يتغير موطنها بسبب سد الممرات الثلاثة. ويوجد في غرب سيبيريا هناك حوالي عشرة فقط من هذه الكركيات في البرية."]},"enwiki":"Siberian crane","image":{"file":"Schneekranich Grus leucogeranus 090501 We 147.JPG","src":"https://upload.wikimedia.org/wikipedia/commons/6/61/Schneekranich_Grus_leucogeranus_090501_We_147.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/61/Schneekranich_Grus_leucogeranus_090501_We_147.JPG/960px-Schneekranich_Grus_leucogeranus_090501_We_147.JPG","page":"https://commons.wikimedia.org/wiki/File:Schneekranich_Grus_leucogeranus_090501_We_147.JPG","author":"BS Thurner Hof","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q4764","ar":"كركي شائع","sci":"Grus grus","en":"Common Crane","iucn":"LC","wdrev":2538973045,"head":"كركي","root":"ك ر ك","arwiki":{"title":"كركي شائع","rev":76374815,"text":["الكركي الشائع أو الكركي المألوف (الاسم العلمي: Grus grus) ويعرف بأسم الكركي الأوراسي هو طائر ينتمي إلى فصيلة الكركي."]},"enwiki":"Common crane","image":{"file":"2017.07.04.-01-Wendisch Rietz--Kranich.jpg","src":"http