{"id":"Q27112","sci":"Tytonidae","ar":"طيطونيات","ord":{"id":"Q25222","sci":"Strigiformes","ar":"بوميات"},"birds":[{"id":"Q781909","ar":"بومة أسترالية مقنعة","sci":"Tyto novaehollandiae","en":"Australian Masked Owl","iucn":"LC","wdrev":2538996305,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة أسترالية مقنعة","rev":75065855,"text":["البومة الأسترالية المقنعة (Tyto novaehollandiae) هي نوع من بوميات الإسطبل تنتشر في جنوب غينيا الجديدة والمناطق غير الصحراوية من أستراليا."]},"enwiki":"Australian masked owl","image":{"file":"Masked owl mask4441.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/b/b0/Masked_owl_mask4441.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Masked_owl_mask4441.jpg/960px-Masked_owl_mask4441.jpg","page":"https://commons.wikimedia.org/wiki/File:Masked_owl_mask4441.jpg","author":"Benjamint444","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q306919","ar":"بومة أعشاب شرقية","sci":"Tyto longimembris","en":"Eastern Grass Owl","iucn":"LC","wdrev":2538982645,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة أعشاب شرقية","rev":76410279,"text":["بومة الأعشاب الشرقية (بالإنجليزية: eastern grass owl) أو بومة الأعشاب الأسترالية (بالإنجليزية: Australian grass owl) (الإسم العلمي: Tyto longimembris). هو نوع من البوميات تتبع فصلية الهامات. هناك من العلماء من يعتبرون إن بومة الأعشاب الشرقية تنتمي إلى نفس نوع بومة الأعشاب الأفريقية، وهناك من يعتبر إن بومة الأعشاب الشرقية هي نوع صحيح سالم. تتغذى بشكل رئيسي على القوارض الصغيرة."]},"enwiki":"Eastern grass owl","image":{"file":"Eastern-grass-owl-1134817.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/4/49/Eastern-grass-owl-1134817.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Eastern-grass-owl-1134817.jpg/960px-Eastern-grass-owl-1134817.jpg","page":"https://commons.wikimedia.org/wiki/File:Eastern-grass-owl-1134817.jpg","author":"Ronny Overhate","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1271582","ar":"بومة تاليابو المقنعة","sci":"Tyto nigrobrunnea","en":"Taliabu masked owl","iucn":"NT","wdrev":2533967364,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة تاليابو المقنعة","rev":72479514,"text":["بومة تاليابو المقنعة ( Tyto nigrobrunnea )، والمعروفة أيضًا باسم بومة تاليابو أو بومة حظيرة جزر سولا، هي بومة من فصيلة بوم الحظيرة. وهي إحدى فصيلتي البوم، بينما الفصيلة الأخرى هي البوم النموذجية. وهي متوطنة في جزيرة تاليابو بإندونيسيا."]},"enwiki":"Taliabu masked owl","image":null,"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1265138","ar":"بومة حمراء","sci":"Tyto soumagnei","en":"Red Owl","iucn":"VU","wdrev":2559451685,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة حمراء","rev":76929912,"text":["البومة الحمراء ( Tyto soumagnei) بومة تنتمي إلى فصيلة بوم الحظيرة. تُعرف أيضًا باسم بومة مدغشقر الحمراء، وبومة عشب مدغشقر، وبومة سوماني، وبومة العشب الصغرى. وهي من الطيور النادرة المقيمة في مدغشقر، والتي لم تكن معروفة تقريبًا منذ اكتشافها عام 1876، حتى إعادة اكتشافها من قِبل باحثين من الصندوق العالمي للطبيعة عام 1993. تُصنف حاليًا على أنها معرضة للانقراض بسبب فقدان موطنها.","تشبه البومة الحمراء بومة الحظيرة العالمية ولكنها أصغر حجمًا (27-30سم) ولها ريش برتقالي كثيف مع بقع سوداء صغيرة. تُعرف أنها تعيش في الغابات دائمة الخضرة الرطبة والغابات النفضية الجافة. تتغذى على الثدييات الصغيرة مثل طيور التنريك ( Tenrecidae ) وفئران الذيل المُخصّب. تعشش وتأوي في تجاويف الأشجار وعلى طول المنحدرات ذات الغطاء النباتي الكثيف."]},"enwiki":"Red owl","image":{"file":"Tyto soumagnei 6733815.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/a/a6/Tyto_soumagnei_6733815.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a6/Tyto_soumagnei_6733815.jpg/960px-Tyto_soumagnei_6733815.jpg","page":"https://commons.wikimedia.org/wiki/File:Tyto_soumagnei_6733815.jpg","author":"Mikael Bauer","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1259972","ar":"بومة رمادية الوجه","sci":"Tyto glaucops","en":"Ashy-faced Owl","iucn":"LC","wdrev":2533967337,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة رمادية الوجه","rev":75707536,"text":["البومة رمادية الوجه (بالإنجليزية: Ashy-faced owl) (الإسم العلمي: Tyto glaucops) هي نوع من البوميات تتبع فصلية الهامات. وتتواجد في هايتي وجمهورية الدومينيكان. الموائل الطبيعة لها هي أراضي الأشجار القمئية شبه الاستوائية أو المدارية الجافة، وأراضي الأشجار القمئية شبه الاستوائية أو المدارية الواقعة على ارتفاعات عالية، وفي الوقت الحاضر تدهورت الغابات سابقة الذكر بشدة."]},"enwiki":"Ashy-faced owl","image":{"file":"Tyto glaucops.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/5/59/Tyto_glaucops.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Tyto_glaucops.jpg/960px-Tyto_glaucops.jpg","page":"https://commons.wikimedia.org/wiki/File:Tyto_glaucops.jpg","author":"John Greenaway from Cardiff, United Kingdom","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1427629","ar":"بومة سخماء صغيرة","sci":"Tyto multipunctata","en":"Lesser Sooty Owl","iucn":"LC","wdrev":2549426905,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة سخماء صغيرة","rev":61841614,"text":["البومة السخماء الصغيرة (الاسم العلمي Tyto multipunctata)، طائر من البوميات وفصيلة بوم الحظائر وتتبع جنس البعفة. تقطن في المنطقة المدارية الرطبة في أستراليا."]},"enwiki":"Lesser sooty owl","image":{"file":"Lesser Sooty Owl (Tyto multipunctata) (30566643833).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/1/11/Lesser_Sooty_Owl_%28Tyto_multipunctata%29_%2830566643833%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/11/Lesser_Sooty_Owl_%28Tyto_multipunctata%29_%2830566643833%29.jpg/960px-Lesser_Sooty_Owl_%28Tyto_multipunctata%29_%2830566643833%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Lesser_Sooty_Owl_(Tyto_multipunctata)_(30566643833).jpg","author":"Dominic Sherony","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1268348","ar":"بومة سخماء كبيرة","sci":"Tyto tenebricosa","en":"Greater Sooty Owl","iucn":"LC","wdrev":2550838802,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة سخماء كبيرة","rev":73251235,"text":["البومة السخماء الكبيرة (الاسم العلمي Tyto tenebricosa)، طائر من البوميات وفصيلة بوم الحظائر وتتبع جنس البعفة. أعطانها أستراليا وغينيا الجديدة في الغابات الجبلية المطيرة وشوهدت في جزيرة فلندرز في مضيق باس."]},"enwiki":"Greater sooty owl","image":{"file":"Sooty Owl A22I9873.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/b/b7/Sooty_Owl_A22I9873.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b7/Sooty_Owl_A22I9873.jpg/960px-Sooty_Owl_A22I9873.jpg","page":"https://commons.wikimedia.org/wiki/File:Sooty_Owl_A22I9873.jpg","author":"JJ Harrison","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q766922","ar":"بومة سولاوسي مقنعة","sci":"Tyto rosenbergii","en":"Tyto rosenbergii","iucn":"LC","wdrev":2559826426,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة سولاوسي مقنعة","rev":61543020,"text":["بومة سولاوسي المقنعة (بالإنجليزية: Sulawesi masked owl) (الإسم العلمي: Tyto rosenbergii) هي نوع من البوميات تتبع فصيلة الهامات. وتستوطن في جزر سولاوسي، وسينغيه، وبيلنغ الإندونيسية. صنفت من قبل الاتحاد الدولي لحفظ الطبيعة بإنها غير مهددة."]},"enwiki":"Sulawesi masked owl","image":{"file":"Sulawesi owl Q0S0008.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/3/36/Sulawesi_owl_Q0S0008.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/3/36/Sulawesi_owl_Q0S0008.jpg","page":"https://commons.wikimedia.org/wiki/File:Sulawesi_owl_Q0S0008.jpg","author":"Lip Kee Yap","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1273539","ar":"بومة كميت الكونغو","sci":"Phodilus prigoginei","en":"Congo bay owl","iucn":"DD","wdrev":2533968152,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة كميت الكونغو","rev":61543029,"text":["بومة كُميت الكونغو (الاسم العلمي: Phodilus prigoginei)، نوع من البومة تنتمي إلى فصيلة الهامة. يقتصر وجودها على منطقة صغيرة في صدع ألبرتين في شرق وسط أفريقيا."]},"enwiki":"Itombwe owl","image":null,"audio":null,"audioFromSearch":false,"video":null},{"id":"Q2315214","ar":"بومة كميت سريلانكية","sci":"Phodilus assimilis","en":"Sri Lanka Bay Owl","iucn":"LC","wdrev":2533968171,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة كميت سريلانكية","rev":73358965,"text":["بومة كُميت سريلانكية (الاسم العلمي: Phodilus assimilis)، نوع منالبومة الكُميت وفصيلة الهامة. يستوطن في جزيرة سريلانكا وغاتس الغربية في ولاية كيرالا، جنوب غرب الهند. كان يُعتبر سابقًا نويعًا من بومة الكُميت الشرقية (Phodilus badius)."]},"enwiki":"Sri Lanka bay owl","image":{"file":"Phodilus assimilis 132558699.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/5/50/Phodilus_assimilis_132558699.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Phodilus_assimilis_132558699.jpg/960px-Phodilus_assimilis_132558699.jpg","page":"https://commons.wikimedia.org/wiki/File:Phodilus_assimilis_132558699.jpg","author":"Renjith Jacob Mathews","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","origin":null},"audio":{"file":"Phodilus assimilis - Sri Lanka Bay Owl XC321933.mp3","src":"https://upload.wikimedia.org/wikipedia/commons/6/67/Phodilus_assimilis_-_Sri_Lanka_Bay_Owl_XC321933.mp3","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wiki/File:Phodilus_assimilis_-_Sri_Lanka_Bay_Owl_XC321933.mp3","author":"Mike Prince","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":"https://xeno-canto.org/321933"},"audioFromSearch":true,"video":null},{"id":"Q770529","ar":"بومة كميت شرقية","sci":"Phodilus badius","en":"Oriental Bay Owl","iucn":"LC","wdrev":2538995328,"head":"بومة","root":"ب و م","arwiki":{"title":"بومة كميت شرقية","rev":68264524,"text":["بومة الكُميت الشرقية (الاسم العلمي: Phodilus badius) هو نوع من فصيلة بوم حظائر."]},"enwiki":"Oriental bay owl","image":{"file":"Oriental bay owl, Phodilus badius - Khao Yai National Park.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/c/c1/Oriental_bay_owl%2C_Phodilus_badius_-_Khao_Yai_National_Park.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c1/Oriental_bay_owl%2C_Phodilus_badius_-_Khao_Yai_National_Park.jpg/960px-Oriental_bay_owl%2C_Phodilus_badius_-_Khao_Yai_National_Park.jpg","page":"https://commons.wikimedia.org/wiki/File:Oriental_bay_owl,_Phodilus_badius_-_Khao_Yai_National_Park.jpg","author":"Rushenb","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q25317","ar":"هامة","sci":"Tyto alba","en":"Western Barn Owl","iucn":"LC","wdrev":2556861363,"head":"هامة","root":null,"arwiki":{"title":"هامة (طائر)","rev":72852967,"text":["الهَامَة أو أمّ الصخر أو البومة المصاصة أو المصاصة أو البومة البيضاء أو البَعْفَة أو بومة المخازن هي أكثر أنواع البوم انتشارًا في العالم وواحدة من أكثر أنواع الطيور انتشارًا، وتوجد في كل مكان تقريبًا في العالم باستثناء المناطق القطبية والصحراوية، وشمال جبال الهيمالايا، ومعظم إندونيسيا، وبعض جزر المحيط الهادئ. حجم الهامات متوسط إلى كبير، ورؤوسها كبيرة، ويميّزها شكل وجهها الذي يشبه القلب، كما تملك الهامات سيقاناً طويلة وقوية ومخالب قوية.","تعيش الهامات في مواطن متنوعة، من الصحاري إلى الغابات، ومن المناطق معتدلة المناخ إلى المناطق الاستوائية. وهي تعد من الطيور المقيمة في الأردن في مناطق مختلفة كوادي الأردن والمناطق الشمالية من المملكة وفي إربد والأزرق والرمثا. ويبلغ طول الهامة حوالي 34 سم.","طُولها يُراوح بين 32 إلى 38 سم. بسطتها من 80 إلى 90 سم. أثوابها إلى البياض الموشَّح والمنمَّش بالأسود والأسمر. مناسرها جالسة الانتشاب. سواقطها مستطيلة ذربة. أذنابها قصيرة وعريضة. أرساغها دقيقة كاسية. مخالبها قليلة الريش. أعطانها العالم وهي في شرقنا الأوسط من الطيور الآبدة تألف الخرائب والأطلال. تُدثّن في الصدوع والأوقاب. إناثها تضع نحو 4 بيضات تحضنها بمناوبة الذكر نحو 24 يوماً. وهي من الروامس تلتمس قوتها في الليل. تصيد الجرذ والفأر والعضال والذباب وجميع أنواع الدويبات والحشرات."]},"enwiki":"Western barn owl","image":{"file":"Tyto alba tylluan wen detail.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/f/f5/Tyto_alba_tylluan_wen_detail.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/Tyto_alba_tylluan_wen_detail.jpg/960px-Tyto_alba_tylluan_wen_detail.jpg","page":"https://commons.wikimedia.org/wiki/File:Tyto_alba_tylluan_wen_detail.jpg","author":"User:Alun Williams333","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":{"file":"Barn Owl (Tyto alba) (W TYTO ALBA R1 C16).ogg","src":"https://upload.wikimedia.org/wikipedia/commons/2/2b/Barn_Owl_%28Tyto_alba%29_%28W_TYTO_ALBA_R1_C16%29.ogg","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wiki/File:Barn_Owl_(Tyto_alba)_(W_TYTO_ALBA_R1_C16).ogg","author":"British Library","license":"CC BY 4.0","licenseUrl":"https://creativecommons.org/licenses/by/4.0","origin":null},"audioFromSearch":false,"video":{"file":"Zittende en vliegende kerkuil overdag-4961692.webm","src":"https://upload.wikimedia.org/wikipedia/commons/9/94/Zittende_en_vliegende_kerkuil_overdag-4961692.webm","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/Zittende_en_vliegende_kerkuil_overdag-4961692.webm/960px--Zittende_en_vliegende_kerkuil_overdag-4961692.webm.jpg","page":"https://commons.wikimedia.org/wiki/File:Zittende_en_vliegende_kerkuil_overdag-4961692.webm","author":"Marc Plomp","license":"CC BY-SA 3.0 nl","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0/nl/deed.en","origin":null}},{"id":"Q9020934","ar":null,"sci":"Tyto almae","en":"Seram Masked Owl","iucn":"DD","wdrev":2533969024,"head":null,"root":null,"arwiki":null,"enwiki":"Seram masked owl","image":null,"audio":null,"audioFromSearch":false,"video":null},{"id":"Q283940","ar":null,"sci":"Tyto aurantia","en":"Golden Masked Owl","iucn":"VU","wdrev":2559451788,"head":null,"root":null,"arwiki":null,"enwiki":"Golden masked owl","image":{"file":"Tyto aurantia (\"Strix aurantiaca\") by Keulemans.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/e/e1/Tyto_aurantia_%28%22Strix_aurantiaca%22%29_by_Keulemans.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/Tyto_aurantia_%28%22Strix_aurantiaca%22%29_by_Keulemans.jpg/960px-Tyto_aurantia_%28%22Strix_aurantiaca%22%29_by_Keulemans.jpg","page":"https://commons.wikimedia.org/wiki/File:Tyto_aurantia_(%22Strix_aurantiaca%22)_by_Keulemans.jpg","author":"John Gerrard Keulemans","license":"Public domain","licenseUrl":null,"origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q385076","ar":null,"sci":"Tyto capensis","en":"African Grass Owl","iucn":"LC","wdrev":2533967277,"head":null,"root":null,"arwiki":null,"enwiki":"African grass owl","image":{"file":"African grass owl, Tyto capensis, Gauteng, South Africa (48413144061).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/6/68/African_grass_owl%2C_Tyto_capensis%2C_Gauteng%2C_South_Africa_%2848413144061%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/African_grass_owl%2C_Tyto_capensis%2C_Gauteng%2C_South_Africa_%2848413144061%29.jpg/960px-African_grass_owl%2C_Tyto_capensis%2C_Gauteng%2C_South_Africa_%2848413144061%29.jpg","page":"https://commons.wikimedia.org/wiki/File:African_grass_owl,_Tyto_capensis,_Gauteng,_South_Africa_(48413144061).jpg","author":"Derek Keats from Johannesburg, South Africa","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1261415","ar":null,"sci":"Tyto inexspectata","en":"Minahasa masked owl","iucn":"LC","wdrev":2533967349,"head":null,"root":null,"arwiki":null,"enwiki":"Minahasa masked owl","image":{"file":"Naturalis Biodiversity Center - ZMA.AVES.47378 - Tyto inexspectata Schlegel, 1879 - Tytonidae - skin specimen.jpeg","src":"https://upload.wikimedia.org/wikipedia/commons/4/43/Naturalis_Biodiversity_Center_-_ZMA.AVES.47378_-_Tyto_inexspectata_Schlegel%2C_1879_-_Tytonidae_-_skin_specimen.jpeg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Naturalis_Biodiversity_Center_-_ZMA.AVES.47378_-_Tyto_inexspectata_Schlegel%2C_1879_-_Tytonidae_-_skin_specimen.jpeg/960px-Naturalis_Biodiversity_Center_-_ZMA.AVES.47378_-_Tyto_inexspectata_Schlegel%2C_1879_-_Tytonidae_-_skin_specimen.jpeg","page":"https://commons.wikimedia.org/wiki/File:Naturalis_Biodiversity_Center_-_ZMA.AVES.47378_-_Tyto_inexspectata_Schlegel,_1879_-_Tytonidae_-_skin_specimen.jpeg","author":"Schlegel, 1879","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":null,"audioFromSearch":false,"video":null}]}