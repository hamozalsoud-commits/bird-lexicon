{"id":"Q13971067","sci":"Buphagidae","ar":null,"ord":{"id":"Q25341","sci":"Passeriformes","ar":"جواثم"},"birds":[{"id":"Q1081513","ar":"أوكسبيكر","sci":"Buphagus erythrorynchus","en":"Buphagus erythrorhynchus","iucn":"LC","wdrev":2549258349,"head":"اوكسبيكر","root":null,"arwiki":{"title":"أوكسبيكر","rev":75983385,"text":["طائر الاوكسبيكر (الإنجليزية: -Oxpecker) الأسم العلمي(الإنجليزية: Oxpecker) هو طائر ينتمي إلى عائلة بوفاجو (الإيطالية: Bufago) . هناك نوعان من من طائر الاوكسبيكر، هما طائر الاوكسبيكر الأحمر المنقار والأصفر المنقار،","وهو طائر بريش ذو اللون البني الفاتح وهناك اثنين من سلالات طائر الاوكسبيكر التي تختلف في الحجم والشكل واللون (المنقار الأصفر أو المنقار الأحمر).","وهو نوع من مملكة الجواثم وهو من الطيور في فصيلة زرزور وأقرب الطيور ألى طائر المينة."]},"enwiki":"Red-billed oxpecker","image":{"file":"Red billed oxpecker close.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/5/50/Red_billed_oxpecker_close.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Red_billed_oxpecker_close.jpg/960px-Red_billed_oxpecker_close.jpg","page":"https://commons.wikimedia.org/wiki/File:Red_billed_oxpecker_close.jpg","author":"Profberger at English Wikipedia","license":"CC BY 2.5","licenseUrl":"https://creativecommons.org/licenses/by/2.5","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q1466229","ar":null,"sci":"Buphagus africanus","en":"yellow-billed oxpecker","iucn":"LC","wdrev":2553599222,"head":null,"root":null,"arwiki":null,"enwiki":"Yellow-billed oxpecker","image":{"file":"Flickr - Rainbirder - Yellow-billed Oxpecker (Buphagus africanus).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/b/b7/Flickr_-_Rainbirder_-_Yellow-billed_Oxpecker_%28Buphagus_africanus%29.jpg","thumb":"https://upload.wikimedia.org/wikipedia/commons/b/b7/Flickr_-_Rainbirder_-_Yellow-billed_Oxpecker_%28Buphagus_africanus%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Flickr_-_Rainbirder_-_Yellow-billed_Oxpecker_(Buphagus_africanu