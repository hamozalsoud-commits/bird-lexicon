imedia.org/wikipedia/commons/a/a9/Madagaskarvorkstaartplevier.JPG","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Madagaskarvorkstaartplevier.JPG/960px-Madagaskarvorkstaartplevier.JPG","page":"https://commons.wikimedia.org/wiki/File:Madagaskarvorkstaartplevier.JPG","author":"Heinonlein","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q116708","ar":"أبو اليسر شرقي","sci":"Glareola maldivarum","en":"Oriental Pratincole","iucn":"LC","wdrev":2538975634,"head":"ابو","root":null,"arwiki":{"title":"أبو اليسر شرقي","rev":74878782,"text":["أبو اليسر شرقي (الاسم العلمي: Glareola  maldivarum) (الإنجليزية: Oriental  Pratincole) هو طائر ينتمي إلى (فصيلة: Glareolidae)."]},"enwiki":"Oriental pratincole","image":{"file":"Glareola maldivarum - Beung Borapet.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/0/07/Glareola_maldivarum_-_Beung_Borapet.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/07/Glareola_maldivarum_-_Beung_Borapet.jpg/960px-Glareola_maldivarum_-_Beung_Borapet.jpg","page":"https://commons.wikimedia.org/wiki/File:Glareola_maldivarum_-_Beung_Borapet.jpg","author":"JJ Harrison (https://www.jjharrison.com.au/)","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null},"audio":{"file":"Glareola maldivarum - Oriental Pratincole XC127902.ogg","src":"https://upload.wikimedia.org/wikipedia/commons/7/79/Glareola_maldivarum_-_Oriental_Pratincole_XC127902.ogg","thumb":"https://commons.wikimedia.org/w/resources/assets/file-type-icons/fileicon-ogg.png","page":"https://commons.wikimedia.org/wiki/File:Glareola_maldivarum_-_Oriental_Pratincole_XC127902.ogg","author":"Sudipto Roy","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":"https://xeno-canto.org/127902"},"audioFromSearch":false,"video":{"file":"Oriental Pratincole 7mile.ogv","src":"https://upload.wikimedia.org/wikipedia/commons/3/3d/Oriental_Pratincole_7mile.ogv","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Oriental_Pratincole_7mile.ogv/330px--Oriental_Pratincole_7mile.ogv.jpg","page":"https://commons.wikimedia.org/wiki/File:Oriental_Pratincole_7mile.ogv","author":"Aviceda","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","origin":null}},{"id":"Q934460","ar":"أبو اليسر صغير","sci":"Glareola lactea","en":"Small Pratincole","iucn":"LC","wdrev":2557291499,"head":"ابو","root":null,"arwiki":{"title":"أبو اليسر صغير","rev":74878783,"text":["أبو اليسر صغير (الاسم العلمي:   Glareola  lactea) (الإنجليزية: Small  Pratincole) هو طائر ينتمي إلى (فصيلة: Glareolidae)."]},"enwiki":"Small pratincole","image":{"file":"Small pratincole (Glareola lactea) Photograph by Shantanu Kuveskar.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/5/5a/Small_pratincole_%28Glareola_lactea%29_Photograph_by_Shantanu_Kuveskar.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Small_pratincole_%28Glareola_lactea%29_Photograph_by_Shantanu_Kuveskar.jpg/960px-Small_pratincole_%28Glareola_lactea%29_Photograph_by_Shantanu_Kuveskar.jpg","page":"https://commons.wikimedia.org/wiki/File:Small_pratincole_(Glareola_lactea)_Photograph_by_Shantanu_Kuveskar.jpg","author":"Shantanu Kuveskar","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q330310","ar":"أبو اليسر مطوق","sci":"Glareola pratincola","en":"Collared Pratincole","iucn":"LC","wdrev":2538982747,"head":"ابو","root":null,"arwiki":{"title":"أبو اليسر مطوق","rev":76374988,"text":["أبو اليسر مطوق أو خولي الأرز أو سبرة المتوسط (الاسم العلمي: Glareola  pratincola) (الإنجليزية: Collared  Pratincole) هو طائر ينتمي إلى (فصيلة: Glareolidae). البالغ من هذا الطائر له بقعة صفراء على رقبته محددة بخط أسود، منقاره أحمر وطرفه أسود، يشبه في طيرانه خطاف البحر أو طائر السنونو فهو سريع الطيران وبإمكانه اصطياد الحشرات في الهواء."]},"enwiki":"Collared pratincole","image":{"file":"Collared pratincole (Glareola pratincola).jpg","src":"https://upload.wikimedia.org/wikipedia/commons/d/d1/Collared_pratincole_%28Glareola_pratincola%29.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/Collared_pratincole_%28Glareola_pratincola%29.jpg/960px-Collared_pratincole_%28Glareola_pratincola%29.jpg","page":"https://commons.wikimedia.org/wiki/File:Collared_pratincole_(Glareola_pratincola).jpg","author":"Steve Garvie (rainbirder)","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","origin":null},"audio":null,"audioFromSearch":false,"video":{"file":"Glareola pratincola - Collared Pratincole 01.webm","src":"https://upload.wikimedia.org/wikipedia/commons/6/68/Glareola_pratincola_-_Collared_Pratincole_01.webm","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Glareola_pratincola_-_Collared_Pratincole_01.webm/960px--Glareola_pratincola_-_Collared_Pratincole_01.webm.jpg","page":"https://commons.wikimedia.org/wiki/File:Glareola_pratincola_-_Collared_Pratincole_01.webm","author":"Zeynel Cebeci","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null}},{"id":"Q219199","ar":"طائر جليل","sci":"Cursorius cursor","en":"Cream-coloured Courser","iucn":"LC","wdrev":2538974398,"head":"طاير","root":null,"arwiki":{"title":"طائر جليل","rev":60931502,"text":["الدراج أو الكروان العسلي ويسمى أيضًا جليل أو جَلِيل أغْبَس أو زُغْزُغ أغْبَس وهو من عائلة الطيور البرية أو الطيور الجافة التي تعيش في الصحراء أو الأماكن التي بها جفاف ويتغذى على اصطياد الحشرات التي تكون موجودة على الأرض. توجد في جزر الكناري وشمال أفريقيا وجنوب غرب آسيا وهي تضع في المرة الواحدة بِيضتين ويحدث هذا أثناء الهجرة خوفاً من أن يموت صغارها وتحدث هذه الهجرة في فصل الشتاء وهي تهاجر إلى دول مثل فنلندا وأيرلندا وبريطانيا العظمى. وما يجعل الكثير من الناس يحبون هذا الطائر هو رشاقته كما أنه تكيف جيداً مع الحياة في الصحراء حيث أن لون ريشه يسمح له باخفاء نفسه لانه يشبه لون الصحاري التي يعيش فيها"]},"enwiki":"Cream-coloured courser","image":{"file":"Cream-coloured Courser, Wadi Degla, Egypt.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/a/a5/Cream-coloured_Courser%2C_Wadi_Degla%2C_Egypt.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Cream-coloured_Courser%2C_Wadi_Degla%2C_Egypt.jpg/960px-Cream-coloured_Courser%2C_Wadi_Degla%2C_Egypt.jpg","page":"https://commons.wikimedia.org/wiki/File:Cream-coloured_Courser,_Wadi_Degla,_Egypt.jpg","author":"Mohamed Sabry Photographer","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q546548","ar":null,"sci":"Cursorius coromandelicus","en":"Indian Courser","iucn":"NT","wdrev":2558714421,"head":null,"root":null,"arwiki":null,"enwiki":"Indian courser","image":{"file":"Indian Courser in Bhigwan August 2025 by Tisha Mukherjee 07.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/4/46/Indian_Courser_in_Bhigwan_August_2025_by_Tisha_Mukherjee_07.jpg","thumb":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Indian_Courser_in_Bhigwan_August_2025_by_Tisha_Mukherjee_07.jpg/960px-Indian_Courser_in_Bhigwan_August_2025_by_Tisha_Mukherjee_07.jpg","page":"https://commons.wikimedia.org/wiki/File:Indian_Courser_in_Bhigwan_August_2025_by_Tisha_Mukherjee_07.jpg","author":"Tisha Mukherjee","license":"CC BY-SA 4.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0","origin":null},"audio":null,"audioFromSearch":false,"video":null},{"id":"Q263815","ar":null,"sci":"Cursorius rufus","en":"Burchell's Courser","iucn":"LC","wdrev":2558714319,"head":null,"root":null,"arwiki":null,"enwiki":"Burchell's courser","image":{"file":"Cursorius rufus00a.jpg","src":"https://upload.wikimedia.org/wikipedia/commons/0/0c/Cursorius_rufus00a.jpg","thumb":"https://upload.wikimedia.org/wikipedia/common